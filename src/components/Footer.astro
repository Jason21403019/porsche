---

---

<footer class="footer">
  <div class="footer-container">
    <h1>Keep abreast<br />of the latest brand news</h1>
    <p>Office@email.com</p>
    <div class="footer-icon">
      <img src="/img/ig.svg" alt="ig" />
      <img src="/img/fb.svg" alt="fb" />
      <img src="/img/yt.svg" alt="yt" />
      <img src="/img/lk.svg" alt="lk" />
    </div>
  </div>
  <img class="footerimg" src="/img/footerimg.png" alt="footerimg" />
</footer>

<style lang="scss">
  .footer {
    position: relative;
    background: linear-gradient(to right, #000000, #676767, #ffce60);
    overflow: hidden;
    &-container {
      display: grid;
      grid-template-columns:
        [start] 300px
        [content-start] minmax(0, 1fr)
        [end];
      padding: clamp(2rem, 5vw, 150px) clamp(1rem, 3vw, 3rem);

      @media (max-width: 992px) {
        grid-template-columns:
          [start] 150px
          [content-start] minmax(0, 1fr)
          [end];
      }

      @media (max-width: 768px) {
        grid-template-columns: 1fr;
      }

      h1,
      p,
      .footer-icon {
        grid-column: content-start / end;

        @media (max-width: 768px) {
          grid-column: 1 / -1;
        }
      }
      h1 {
        font-size: 64px;
        color: white;
        margin-bottom: 64px;

        @media (max-width: 992px) {
          font-size: 48px;
          margin-bottom: 40px;
        }

        @media (max-width: 768px) {
          font-size: 36px;
          margin-bottom: 30px;
        }

        @media (max-width: 480px) {
          font-size: 28px;
          margin-bottom: 20px;
        }
      }
      p {
        font-size: 32px;
        color: white;

        @media (max-width: 992px) {
          font-size: 24px;
        }

        @media (max-width: 768px) {
          font-size: 20px;
        }

        &::after {
          content: '';
          display: block;
          width: 100%;
          height: 2px;
          background: white;
          margin: 20px 0;
          margin-bottom: 64px;

          @media (max-width: 768px) {
            margin-bottom: 30px;
          }

          @media (max-width: 480px) {
            margin-bottom: 20px;
          }
        }
      }
      .footer-icon {
        display: flex;
        cursor: pointer;
        flex-wrap: wrap;
        img {
          width: 50px;
          height: 50px;
          margin-right: 20px;
          margin-bottom: 15px;

          @media (max-width: 992px) {
            width: 40px;
            height: 40px;
            margin-right: 15px;
          }

          @media (max-width: 480px) {
            width: 35px;
            height: 35px;
            margin-right: 12px;
          }
        }
      }
    }
    .footerimg {
      position: absolute;
      top: 25%;
      right: 0;
      width: auto;
      height: 70%;
      object-fit: contain;
      opacity: 1;
      transform: translateX(0);

      @media (max-width: 992px) {
        height: 60%;
        opacity: 0.8;
      }

      @media (max-width: 768px) {
        height: 50%;
        top: 40%;
        opacity: 0.6;
      }

      @media (max-width: 480px) {
        height: 40%;
        opacity: 0.4;
      }
    }
  }
</style>
