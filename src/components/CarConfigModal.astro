        batteryCapacity: '100 kWh',
        range: '490 km (WLTP)',
      },
      'Macan Turbo': {
        driveSystem: 'All-wheel drive',
        power: '470 kW / 639 PS',
        torque: '1130 Nm',
        acceleration: '3.3 seconds',
        topSpeed: '260 km/h',
        batteryCapacity: '100 kWh',
        range: '465 km (WLTP)',
      },
    }

    // 建立車型名稱別名映射，解決大小寫不一致問題
    const carNameAliases = {
      'taycan turbo gt with wp': 'Taycan Turbo GT with WP',
      'taycan turbo gt with weissach package': 'Taycan Turbo GT with WP',
      // Macan 別名
      'macan electric': 'Macan',
      'macan 4 electric': 'Macan 4',
      'macan s electric': 'Macan S',
      'macan gts electric': 'Macan GTS',
      'macan turbo electric': 'Macan Turbo',
    }

    // 獲取車型的規格資料 (帶容錯處理)
    function getCarSpecs(carName) {
      // 先規範化名稱
      const normalizedName = normalizeCarName(carName)

      // 直接查找
      if (carSpecs[normalizedName]) {
        return carSpecs[normalizedName]
      }

      // 嘗試使用別名映射
      const lowerName = normalizedName.toLowerCase()
      if (carNameAliases[lowerName] && carSpecs[carNameAliases[lowerName]]) {
        return carSpecs[carNameAliases[lowerName]]
      }

      // 模糊匹配 - 檢查是否是名稱的一部分
      for (const key of Object.keys(carSpecs)) {
        if (
          key.toLowerCase().includes(lowerName) ||
          lowerName.includes(key.toLowerCase())
        ) {
          return carSpecs[key]
        }
      }

      return null // 找不到匹配的規格資料
    }

    // 獲取車型的圖片 (帶容錯處理)
    function getCarImage(carName) {
      // 先規範化名稱
      const normalizedName = normalizeCarName(carName)

      // 直接查找
      if (carImages[normalizedName]) {
        return carImages[normalizedName]
      }

      // 嘗試使用別名映射
      const lowerName = normalizedName.toLowerCase()
      if (carNameAliases[lowerName] && carImages[carNameAliases[lowerName]]) {
        return carImages[carNameAliases[lowerName]]
      }

      // 模糊匹配 - 檢查是否是名稱的一部分
      for (const key of Object.keys(carImages)) {
        if (
          key.toLowerCase().includes(lowerName) ||
          lowerName.includes(key.toLowerCase())
        ) {
          return carImages[key]
        }
      }

      // 找不到匹配的圖片，使用默認圖片
      return '/img/taycan.png'
    }

    // 獲取所有車型的名稱
    const allCarModels = Object.keys(carSpecs)

    // 接收來自 window 的自定義事件
    window.addEventListener('openCarConfig', (event) => {
      if (event.detail && event.detail.carName) {
        openConfigModal(event.detail.carName)
      }
    })

    // 開啟燈窗的函數
    function openConfigModal(carName) {
      if (!modal) return

      // 規範化車型名稱
      const normalizedCarName = normalizeCarName(carName)
      console.log(
        `嘗試開啟車型配置: ${carName} (規範化為: ${normalizedCarName})`
      )

      // 設置側邊欄車型名稱
      sidebarCarTitle.textContent = normalizedCarName

      // 獲取車輛圖片
      const imagePath = getCarImage(normalizedCarName)
      if (imagePath) {
        sidebarCarImage.src = imagePath
        sidebarCarImage.alt = normalizedCarName
        sidebarCarImage.dataset.currentCar = normalizedCarName
        console.log(`更新車輛圖片: ${normalizedCarName} - ${imagePath}`)
      } else {
        console.warn(`找不到車型 "${normalizedCarName}" 的圖片，使用默認圖片`)
        sidebarCarImage.src = '/img/taycan.png'
      }

      // 更新技術規格資料
      const specs = getCarSpecs(normalizedCarName)
      if (specs) {
        document.getElementById('techDriveSystem').textContent =
          specs.driveSystem
        document.getElementById('techPower').textContent = specs.power
        document.getElementById('techTorque').textContent = specs.torque
        document.getElementById('techAcceleration').textContent =
          specs.acceleration
        document.getElementById('techTopSpeed').textContent = specs.topSpeed
        document.getElementById('techBatteryCapacity').textContent =
          specs.batteryCapacity
        document.getElementById('techRange').textContent = specs.range
      } else {
        console.warn(`找不到車型 "${normalizedCarName}" 的規格資料，使用默認值`)
      }

      // 更新比較表格
      updateComparisonTable(normalizedCarName)

      modal.style.display = 'block'
      document.body.style.overflow = 'hidden' // 防止背景滾動

      // 重置為默認 TAB (配置車輛)
      activateTab('configure')

      // 確保所有 Splide 輪播到第一張
      Object.values(splideSliders).forEach((slider) => {
        if (slider && typeof slider.go === 'function') {
          slider.go(0)
        }
      })

      // 彈窗顯示後重新初始化輪播，解決初始隱藏狀態下的問題
      setTimeout(() => {
        Object.values(splideSliders).forEach((slider) => {
          if (slider && typeof slider.refresh === 'function') {
            slider.refresh()
            // 確保從第一張開始展示
            slider.go(0)
          }
        })
      }, 100)
    }

    // 點擊燈窗外部關閉
    window.addEventListener('click', function (event) {
      if (event.target === modal) {
        modal.style.display = 'none'
        document.body.style.overflow = 'auto'
      }
    })

    // TAB 切換功能
    const tabButtons = document.querySelectorAll('.tab-button')
    const tabContents = document.querySelectorAll('.tab-content')

    function activateTab(tabId) {
      // 移除所有 tab 按鈕的 active 類別
      tabButtons.forEach((button) => {
        button.classList.remove('active')
      })

      // 移除所有 tab 內容的 active 類別
      tabContents.forEach((content) => {
        content.classList.remove('active')
      })

      // 激活所選 tab 的按鈕
      const activeButton = document.querySelector(
        `.tab-button[data-tab="${tabId}"]`
      )
      if (activeButton) {
        activeButton.classList.add('active')
      }

      // 激活所選 tab 的內容
      const activeContent = document.getElementById(`${tabId}-tab`)
      if (activeContent) {
        activeContent.classList.add('active')
      }

      // 如果是配置車輛 TAB，確保所有 Splide 滑塊刷新
      if (tabId === 'configure') {
        setTimeout(() => {
          Object.values(splideSliders).forEach((slider) => {
            if (slider && typeof slider.refresh === 'function') {
              slider.refresh()
            }
          })
        }, 50)
      }

      // 如果切換到比較頁籤，更新比較表格
      if (tabId === 'compare') {
        const currentCar = sidebarCarTitle.textContent
        updateComparisonTable(currentCar)
      }
    }

    // 綁定 tab 按鈕點擊事件
    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const tabId = button.getAttribute('data-tab')
        activateTab(tabId)
      })
    })

    // Initialize Splide
    const commonOptions = {
      type: 'slide',
      perPage: 3, // 確保每次顯示恰好三個選項
      perMove: 1,
      gap: '1rem', // 增加間距以改善視覺效果
      pagination: false,
      arrows: true, // 啟用箭頭導航
      drag: true,
      height: '120px',
      padding: {
        left: '0', // 移除左右內邊距以確保顯示正好三個項目
        right: '0',
      },
      focus: 'center', // 確保內容居中顯示
      trimSpace: false, // 禁止修剪空間以確保顯示三個項目
      autoWidth: false, // 禁用自動寬度
      fixedWidth: false, // 禁用固定寬度
      easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
      classes: {
        arrows: 'splide__arrows',
        arrow: 'splide__arrow',
        prev: 'splide__arrow--prev',
        next: 'splide__arrow--next',
      },
      start: 0, // 確保從第一張開始
      breakpoints: {
        768: {
          perPage: 2, // 平板上顯示2個
        },
        450: {
          perPage: 1, // 手機上顯示1個
        },
      },
    }

    // 為顏色選擇器設置特殊選項
    const colorOptions = {
      ...commonOptions,
      // 顏色選擇器保持相同的基本設置，但可能需要調整間距
      gap: '2rem', // 增加顏色選項間的間距
    }

    // 初始化所有輪播 (移除套件滑塊初始化)
    let splideSliders = {}

    try {
      // 確保DOM元素存在再進行初始化
      if (document.querySelector('.color-slider')) {
        splideSliders.color = new Splide('.color-slider', colorOptions)
        splideSliders.color.mount()
        splideSliders.color.go(0) // 確保從第一張開始
      }

      if (document.querySelector('.wheel-slider')) {
        splideSliders.wheel = new Splide('.wheel-slider', commonOptions)
        splideSliders.wheel.mount()
        splideSliders.wheel.go(0)
      }

      if (document.querySelector('.seat-slider')) {
        splideSliders.seat = new Splide('.seat-slider', commonOptions)
        splideSliders.seat.mount()
        splideSliders.seat.go(0)
      }

      if (document.querySelector('.interior-slider')) {
        splideSliders.interior = new Splide('.interior-slider', commonOptions)
        splideSliders.interior.mount()
        splideSliders.interior.go(0)
      }

      // 確保在視窗大小變化時重新計算佈局，但保持在當前選擇的位置
      window.addEventListener('resize', () => {
        Object.values(splideSliders).forEach((slider) => {
          if (slider && typeof slider.refresh === 'function') {
            const currentIndex = slider.index
            slider.refresh()
            slider.go(currentIndex) // 保持在當前選擇的項目
          }
        })
      })

      // 延遲檢查並修復箭頭樣式和事件
      setTimeout(() => {
        document.querySelectorAll('.splide__arrow').forEach((arrow) => {
          // 確保箭頭可見並正確定位
          arrow.style.opacity = '1'
          arrow.style.zIndex = '10'

          // 為箭頭添加額外點擊事件（用於除錯和確保功能正常）
          arrow.addEventListener('click', function (e) {
            console.log(
              '箭頭被點擊',
              this.classList.contains('splide__arrow--prev')
                ? '上一個'
                : '下一個'
            )
            e.stopPropagation() // 阻止事件冒泡
          })
        })
      }, 200) // 延遲以確保DOM完全渲染
    } catch (error) {
      console.error('初始化Splide輪播時出錯:', error)
    }

    // 選項點擊事件處理
    const handleOptionClick = (optionClass) => {
      document.querySelectorAll(`.${optionClass}`).forEach((option) => {
        option.addEventListener('click', function () {
          document.querySelectorAll(`.${optionClass}`).forEach((opt) => {
            opt.classList.remove('selected')
          })
          this.classList.add('selected')
        })
      })
    }

    // 綁定所有選項的點擊事件
    ;[
      'color-option',
      'wheel-option',
      'seat-option',
      'interior-option',
      'package-option',
    ].forEach(handleOptionClick)

    // 顏色選擇功能增強 - 重用現有點擊事件處理並新增控制台輸出
    document.querySelectorAll('.color-option').forEach((colorOption) => {
      colorOption.addEventListener('click', function () {
        const colorName = this.dataset.color
        const currentCar = sidebarCarImage.dataset.currentCar || 'Taycan'
        console.log(`已選擇 ${currentCar} 的 ${colorName} 顏色`)
      })
    })

    // 修改套件選擇功能
    document.querySelectorAll('.package-option').forEach((packageOption) => {
      packageOption.addEventListener('click', function () {
        // 從 data 屬性獲取套件資訊而不是從子元素
        const packageName = this.dataset.package || '未命名套件'
        const packagePrice = this.dataset.price || '價格未定'
        console.log(`已選擇套件: ${packageName} - ${packagePrice}`)

        // 移除其他套件的選中狀態並設置當前套件為選中
        document.querySelectorAll('.package-option').forEach((opt) => {
          opt.classList.remove('selected')
        })
        this.classList.add('selected')
      })
    })

    // 更多車輛 TAB 中的配置車輛按鈕事件 (未來功能)
    /*
    document.querySelectorAll('.car-config-btn').forEach((btn) => {
      btn.addEventListener('click', function () {
        const carName = this.parentNode.querySelector('h3').textContent
        console.log(`要配置的車輛: ${carName}`)

        // 切換到配置車輛 TAB
        activateTab('configure')

        // 如果需要，更新側邊欄的車型和圖片
        if (carImages[carName]) {
          sidebarCarTitle.textContent = carName
          sidebarCarImage.src = carImages[carName]
          sidebarCarImage.alt = carName
          sidebarCarImage.dataset.currentCar = carName
        }
      })
    })
    */

    // 更新比較表格
    function updateComparisonTable(selectedCar) {
      // 獲取表格元素
      const tableHeader = document.getElementById('comparisonTableHeader')
      const tableBody = document.getElementById('comparisonTableBody')

      if (!tableHeader || !tableBody) {
        console.error('比較表格元素不存在')
        return
      }

      // 清空表格內容，只保留第一列（參數列）
      tableHeader.innerHTML = '<th>Parameters</th>'
      tableBody.innerHTML = ''

      // 規範化所選車型
      const normalizedSelectedCar = normalizeCarName(selectedCar)

      // 根據螢幕寬度決定要比較的車型數量
      const screenWidth = window.innerWidth
      let carsToCompareCount = screenWidth <= 768 ? 2 : 4

      // 額外針對 450px 以下的小螢幕增加判斷
      if (screenWidth <= 450) {
        carsToCompareCount = 1 // 在極小螢幕上只顯示選中的車型
      }

      // 選擇要比較的車型（根據螢幕寬度決定數量，包括當前選中的車型）
      const carsToCompare = getComparisonCars(
        normalizedSelectedCar,
        carsToCompareCount
      )

      console.log(
        `比較車型: ${carsToCompare.join(', ')} (螢幕寬度: ${screenWidth}px, 顯示: ${carsToCompareCount}台車)`
      )

      // 生成表頭
      carsToCompare.forEach((car) => {
        const th = document.createElement('th')
        th.textContent = car
        tableHeader.appendChild(th)
      })

      // 定義需要比較的參數和顯示的標籤
      const comparisonParams = [
        {key: 'driveSystem', label: 'Drive System'},
        {key: 'power', label: 'Maximum Power'},
        {key: 'torque', label: 'Maximum Torque'},
        {key: 'acceleration', label: 'Acceleration (0-100 km/h)'},
        {key: 'topSpeed', label: 'Top Speed'},
        {key: 'batteryCapacity', label: 'Battery Capacity'},
        {key: 'range', label: 'Maximum Range'},
      ]

      // 生成表格內容
      comparisonParams.forEach((param) => {
        const row = document.createElement('tr')

        // 添加參數名稱
        const paramCell = document.createElement('td')
        paramCell.textContent = param.label
        row.appendChild(paramCell)

        // 為每個車型添加對應參數值
        carsToCompare.forEach((car) => {
          const valueCell = document.createElement('td')
          // 獲取車型規格
          const specs = getCarSpecs(car)

          if (specs && specs[param.key]) {
            valueCell.textContent = specs[param.key]
          } else {
            valueCell.textContent = 'N/A'
            console.warn(`車型 ${car} 缺少參數: ${param.key}`)
          }
          row.appendChild(valueCell)
        })

        tableBody.appendChild(row)
      })
    }

    // 選擇要比較的車型
    function getComparisonCars(selectedCar, count) {
      // 確保 count 為有效值
      count = Math.max(2, Math.min(count || 4, allCarModels.length)) // 將選中的車型放在第一位
      let result = [selectedCar] // 按類別分組車型 - 優化 MACAN 分組邏輯
      const carGroups = {
        // Taycan 系列分組
        'Taycan Entry Level': ['Taycan', 'Taycan 4'],
        'Taycan Mid-Range': ['Taycan 4S', 'Taycan GTS'],
        'Taycan High Performance': ['Taycan Turbo', 'Taycan Turbo S'],
        'Taycan Ultra Performance': [
          'Taycan Turbo GT',
          'Taycan Turbo GT with WP',
        ],

        // Macan 系列分組 - 重新優化分組
        'Macan Entry Level': ['Macan', 'Macan 4'],
        'Macan Sport Performance': ['Macan S'],
        'Macan High Performance': ['Macan GTS'],
        'Macan Ultimate Performance': ['Macan Turbo'],

        // 跨系列比較分組 - 按性能等級
        'Entry Electric SUV/Sedan': ['Taycan', 'Macan'],
        'AWD Electric Vehicles': ['Taycan 4', 'Macan 4'],
        'Sport Performance Electric': ['Taycan GTS', 'Macan S'],
        'Ultimate Performance': ['Taycan Turbo GT', 'Macan Turbo'],
      } // 確定所選車型屬於哪個組 - 支援多組歸屬
      let selectedGroups = []
      for (const [group, cars] of Object.entries(carGroups)) {
        if (cars.includes(selectedCar)) {
          selectedGroups.push(group)
        }
      }

      // 智能選擇比較車型的優先級策略
      const getComparisonPriority = (selectedCar) => {
        const carSeries = selectedCar.startsWith('Taycan') ? 'Taycan' : 'Macan'
        const otherSeries = carSeries === 'Taycan' ? 'Macan' : 'Taycan'

        // 優先級順序：
        // 1. 同性能等級的對手品牌車型
        // 2. 同系列不同性能等級車型
        // 3. 其他系列車型

        const priorityGroups = []

        // 找到跨系列比較分組
        for (const group of selectedGroups) {
          if (group.includes('Electric') && carGroups[group].length > 1) {
            priorityGroups.push(group)
          }
        }

        // 添加同系列其他性能等級
        for (const [group, cars] of Object.entries(carGroups)) {
          if (group.includes(carSeries) && !selectedGroups.includes(group)) {
            priorityGroups.push(group)
          }
        }

        // 添加對手系列車型
        for (const [group, cars] of Object.entries(carGroups)) {
          if (group.includes(otherSeries)) {
            priorityGroups.push(group)
          }
        }

        return priorityGroups
      }

      const priorityGroups = getComparisonPriority(selectedCar)

      // 按優先級選擇比較車型
      for (const group of priorityGroups) {
        if (result.length < count && carGroups[group]) {
          for (const car of carGroups[group]) {
            if (!result.includes(car) && result.length < count) {
              result.push(car)
              break // 每組只選一台代表車型
            }
          }
        }
      }

      // 如果仍未達到要求的數量，從所有車型中選擇尚未選擇的車型
      if (result.length < count) {
        for (const car of allCarModels) {
          if (!result.includes(car) && result.length < count) {
            result.push(car)
          }
        }
      }

      // 確保不超過要求的數量
      return result.slice(0, count)
    } // 添加視窗大小變化的事件監聽器，以便在視窗大小改變時更新表格
    let resizeTimeout: NodeJS.Timeout | undefined
    window.addEventListener('resize', () => {
      // 使用 debounce 技術防止過於頻繁地更新
      if (resizeTimeout) {
        clearTimeout(resizeTimeout)
      }
      resizeTimeout = setTimeout(() => {
        // 僅當比較標籤已啟用時才更新表格
        const compareTab = document.getElementById('compare-tab')
        if (compareTab && compareTab.classList.contains('active')) {
          const currentCar = sidebarCarTitle.textContent
          updateComparisonTable(currentCar)
          console.log(`視窗大小已變更，更新比較表格 (當前車型: ${currentCar})`)
        }
      }, 250) // 等待 250ms 再觸發更新
    })

    // 測試函數 - 可在需要時呼叫以驗證映射和數據
    function testCarData() {
      console.log('=== 測試車型圖片和資料 ===')

      // 檢查所有車型圖片
      for (const car of allCarModels) {
        if (carImages[car]) {
          console.log(`${car} - 圖片: ${carImages[car]}`)
        } else {
          console.error(`${car} - 圖片缺失`)
        }
      }

      // 檢查所有車型規格資料
      for (const car of allCarModels) {
        if (carSpecs[car]) {
          console.log(`${car} - 規格資料完整`)
        } else {
          console.error(`${car} - 規格資料缺失`)
        }
      } // 測試比較功能 - 包含 MACAN 車型測試
      console.log('=== 新分組方式比較車型測試 ===')

      // 測試 Taycan 系列
      for (const car of ['Taycan', 'Taycan 4S', 'Taycan Turbo GT']) {
        ;[2, 3, 4].forEach((count) => {
          const comparisonCars = getComparisonCars(car, count)
          console.log(
            `${car} 的比較車型 (${count}台): ${comparisonCars.join(', ')}`
          )
        })
      }

      // 測試 Macan 系列
      console.log('--- MACAN 系列比較測試 ---')
      for (const car of [
        'Macan',
        'Macan 4',
        'Macan S',
        'Macan GTS',
        'Macan Turbo',
      ]) {
        ;[2, 3, 4].forEach((count) => {
          const comparisonCars = getComparisonCars(car, count)
          console.log(
            `${car} 的比較車型 (${count}台): ${comparisonCars.join(', ')}`
          )
        })
      }

      // 測試跨系列比較
      console.log('--- 跨系列比較測試 ---')
      const crossSeriesTests = [
        {selected: 'Taycan', expected: 'Should include Macan'},
        {selected: 'Macan GTS', expected: 'Should include Taycan GTS'},
        {selected: 'Macan Turbo', expected: 'Should include Taycan Turbo GT'},
      ]

      crossSeriesTests.forEach((test) => {
        const comparisonCars = getComparisonCars(test.selected, 3)
        console.log(
          `${test.selected} 跨系列比較: ${comparisonCars.join(', ')} (${test.expected})`
        )
      })
    }

    // 執行測試 (可以在控制台觀察結果)
    testCarData()
  })
</script>
