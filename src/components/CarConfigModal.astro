</style>

<script
  src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"
></script>
<script type="module">
  // 修正導入路徑 - 確保指向正確的資料檔案位置
  import {
    carImages,
    carSpecs,
    carNameAliases,
    carGroups,
    comparisonParams,
    allCarModels,
    getCarConfiguration,
    getAvailableColors,
    getAvailableWheels,
    getWheelImagePath,
    optionalPackages,
    getOptionalPackages,
    getPackageImagePath,
    getOptionalPackageImagePath,
    getSmartPackageImagePath,
    getColorMainImagePath,
    loadJsonData,
  } from '/js/carData.js'

  // 燈窗功能
  document.addEventListener('DOMContentLoaded', async () => {
    // 確保 JSON 資料已載入
    await loadJsonData()

    const modal = document.getElementById('carConfigModal')
    const sidebarCarTitle = document.getElementById('sidebarCarTitle')
    const sidebarCarImage = document.getElementById('sidebarCarImage')

    // 車型名稱規範化函數
    function normalizeCarName(name) {
      const normalized = name
        .replace(/\bwp\b/gi, 'WP')
        .replace(/\bgts\b/gi, 'GTS')
        .replace(/\bgt\b/gi, 'GT')
        .trim()

      for (const key of Object.keys(carImages)) {
        if (key.toLowerCase() === normalized.toLowerCase()) {
          return key
        }
      }
      return normalized
    }

    // 獲取車型的規格資料
    function getCarSpecs(carName) {
      const normalizedName = normalizeCarName(carName)

      if (carSpecs[normalizedName]) {
        return carSpecs[normalizedName]
      }

      const lowerName = normalizedName.toLowerCase()
      if (carNameAliases[lowerName] && carSpecs[carNameAliases[lowerName]]) {
        return carSpecs[carNameAliases[lowerName]]
      }

      for (const key of Object.keys(carSpecs)) {
        if (
          key.toLowerCase().includes(lowerName) ||
          lowerName.includes(key.toLowerCase())
        ) {
          return carSpecs[key]
        }
      }

      return null
    }

    // 獲取車型的圖片
    function getCarImage(carName) {
      const normalizedName = normalizeCarName(carName)

      if (carImages[normalizedName]) {
        return carImages[normalizedName]
      }

      const lowerName = normalizedName.toLowerCase()
      if (carNameAliases[lowerName] && carImages[carNameAliases[lowerName]]) {
        return carImages[carNameAliases[lowerName]]
      }

      for (const key of Object.keys(carImages)) {
        if (
          key.toLowerCase().includes(lowerName) ||
          lowerName.includes(key.toLowerCase())
        ) {
          return carImages[key]
        }
      }

      return '/img/taycan.png'
    } // 獲取所有車型的名稱
    const allCarModels = Object.keys(carSpecs)

    // 全局變量來追蹤當前選擇的顏色和輪框
    let currentCarConfiguration = null
    let selectedColorIndex = 1
    let selectedWheelIndex = 1 // 預設都為第二個

    // 動態更新顏色選項
    function updateColorOptions(carModel) {
      const colorSlider = document.querySelector('.color-slider .splide__list')
      if (!colorSlider) return

      const availableColors = getAvailableColors(carModel)

      // 清空現有選項
      colorSlider.innerHTML = ''

      // 生成新的顏色選項
      availableColors.forEach((color, index) => {
        const slide = document.createElement('li')
        slide.className = 'splide__slide'

        const colorOption = document.createElement('div')
        colorOption.className = 'color-option'
        colorOption.style.backgroundColor = color.backgroundColor
        colorOption.dataset.colorCode = color.colorCode
        colorOption.dataset.colorName = color.colorName
        colorOption.dataset.colorIndex = index
        colorOption.title = color.colorName // 確保顏色選項的基本樣式
        colorOption.style.width = '32px'
        colorOption.style.height = '32px'
        colorOption.style.borderRadius = '50%'
        colorOption.style.cursor = 'pointer'
        colorOption.style.border = '2px solid #ddd'
        colorOption.style.transition = 'all 0.3s'
        colorOption.style.flexShrink = '0'
        colorOption.style.margin = '0 auto'
        colorOption.style.display = 'block'

        // 如果是第二個顏色，應用選中狀態的樣式
        if (index === 1) {
          colorOption.classList.add('selected')
          colorOption.style.transform = 'scale(1.3)'
          colorOption.style.borderColor = '#ffce60'
        }

        slide.appendChild(colorOption)
        colorSlider.appendChild(slide)
      })

      // 刷新顏色滑塊
      if (splideSliders.color) {
        splideSliders.color.refresh()
        splideSliders.color.go(0)
      }

      // 綁定顏色選擇事件
      bindColorSelectionEvents(carModel)
    } // 動態更新輪框選項
    function updateWheelOptions(carModel, colorCode) {
      const wheelSlider = document.querySelector('.wheel-slider .splide__list')
      if (!wheelSlider) return

      // 清空現有選項
      wheelSlider.innerHTML = ''

      // 生成輪框選項
      for (let wheelNumber = 1; wheelNumber <= 3; wheelNumber++) {
        const slide = document.createElement('li')
        slide.className = 'splide__slide'

        const wheelOption = document.createElement('div')
        wheelOption.className = 'wheel-option'
        wheelOption.dataset.wheelNumber = wheelNumber

        // 確保輪框選項的基本樣式
        wheelOption.style.width = '100px'
        wheelOption.style.height = '100px'
        wheelOption.style.display = 'flex'
        wheelOption.style.justifyContent = 'center'
        wheelOption.style.alignItems = 'center'
        wheelOption.style.textAlign = 'center'
        wheelOption.style.borderRadius = '8px'
        wheelOption.style.cursor = 'pointer'
        wheelOption.style.transition = 'all 0.3s ease'
        wheelOption.style.flexShrink = '0'
        wheelOption.style.overflow = 'hidden'
        wheelOption.style.backgroundColor = '#f5f5f5'

        // 如果是第二個輪框，應用選中狀態的樣式
        if (wheelNumber === 2) {
          wheelOption.classList.add('selected')
          wheelOption.style.width = '112px'
          wheelOption.style.height = '112px'
          wheelOption.style.border = '3px solid #ffce60'
          wheelOption.style.boxShadow = '0 0 12px rgba(255, 206, 96, 0.7)'
          wheelOption.style.backgroundColor = '#fffbeb'
        }
        const img = document.createElement('img')
        const wheelImagePath = getWheelImagePath(
          carModel,
          colorCode,
          wheelNumber
        )
        img.src = wheelImagePath || '/img/wheel1.png' // 使用預設圖片作為後備
        img.alt = `Wheel ${wheelNumber}`

        img.style.width = '100%'
        img.style.height = '100%'
        img.style.objectFit = 'cover'
        img.style.display = 'block'
        img.style.aspectRatio = '1 / 1'
        img.style.borderRadius = '8px'

        img.onerror = function () {
          // 如果圖片載入失敗，使用預設圖片
          console.warn(`⚠️ 輪框圖片載入失敗: ${this.src}，改用預設圖片`)
          this.src = `/img/wheel${wheelNumber}.png`
        }

        wheelOption.appendChild(img)
        slide.appendChild(wheelOption)
        wheelSlider.appendChild(slide)
      }

      // 刷新輪框滑塊
      if (splideSliders.wheel) {
        splideSliders.wheel.refresh()
        splideSliders.wheel.go(0)
      }

      // 綁定輪框選擇事件
      bindWheelSelectionEvents()
    } // 動態更新套件選項
    function updatePackageOptions(carModel, colorCode, wheelNumber) {
      const packageContainer = document.querySelector('.package-container')
      if (!packageContainer) return

      const availablePackages = getOptionalPackages(carModel)

      // 清空現有選項
      packageContainer.innerHTML = ''

      // 生成新的套件選項
      availablePackages.forEach((package_, index) => {
        const packageOption = document.createElement('div')
        packageOption.className = 'package-option'
        packageOption.dataset.package = package_.name
        packageOption.dataset.price = package_.price
        packageOption.dataset.packageIndex = index
        packageOption.title = `${package_.name} - ${package_.price}`

        // 手動應用基本樣式 - 簡化為圖片容器
        packageOption.style.cssText = `
          width: 240px;
          height: 140px;
          border-radius: 8px;
          border: none;
          cursor: pointer;
          transition: all 0.3s ease;
          overflow: hidden;
          background-color: #f5f5f5;
          display: flex;
          justify-content: center;
          align-items: center;
          box-sizing: border-box;
        ` // 創建圖片元素
        const img = document.createElement('img')
        // 使用新的參數格式：colorCode 和 wheelNumber 而不是 colorIndex 和 wheelIndex

        const packageImagePath = package_.getImagePath
          ? package_.getImagePath(colorCode, wheelNumber, carModel)
          : package_.fallbackImage || '/img/car1.png'

        img.src = packageImagePath
        img.alt = package_.name

        // 圖片樣式 - 填滿整個容器
        img.style.cssText = `
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
          border-radius: 4px;
        `

        packageOption.appendChild(img)
        packageContainer.appendChild(packageOption)
      })

      // 綁定套件選擇事件
      bindPackageSelectionEvents()
    }

    // 綁定顏色選擇事件
    function bindColorSelectionEvents(carModel) {
      document
        .querySelectorAll('.color-option')
        .forEach((colorOption, index) => {
          // 添加 hover 效果
          colorOption.addEventListener('mouseenter', function () {
            if (!this.classList.contains('selected')) {
              this.style.transform = 'scale(1.3)'
              this.style.borderColor = '#ffce60'
            }
          })

          colorOption.addEventListener('mouseleave', function () {
            if (!this.classList.contains('selected')) {
              this.style.transform = 'scale(1)'
              this.style.borderColor = '#ddd'
            }
          })

          colorOption.addEventListener('click', function () {
            // 移除其他顏色的選中狀態
            document.querySelectorAll('.color-option').forEach((opt) => {
              opt.classList.remove('selected')
              opt.style.transform = 'scale(1)'
              opt.style.borderColor = '#ddd'
            }) // 設置當前顏色為選中
            this.classList.add('selected')
            this.style.transform = 'scale(1.3)'
            this.style.borderColor = '#ffce60'

            const colorCode = this.dataset.colorCode
            const colorName = this.dataset.colorName
            selectedColorIndex = index

            // 更新輪框選項以反映新顏色
            updateWheelOptions(carModel, colorCode)

            // 更新套件選項以反映新顏色和當前輪框
            const currentWheelNumber = selectedWheelIndex + 1
            updatePackageOptions(carModel, colorCode, currentWheelNumber)
          })
        })
    } // 綁定輪框選擇事件
    function bindWheelSelectionEvents() {
      document
        .querySelectorAll('.wheel-option')
        .forEach((wheelOption, index) => {
          // 添加 hover 效果
          wheelOption.addEventListener('mouseenter', function () {
            if (!this.classList.contains('selected')) {
              this.style.width = '112px'
              this.style.height = '112px'
              this.style.boxShadow = '0 0 8px rgba(255, 206, 96, 0.5)'
              this.style.backgroundColor = '#fffbeb'
            }
          })

          wheelOption.addEventListener('mouseleave', function () {
            if (!this.classList.contains('selected')) {
              this.style.width = '100px'
              this.style.height = '100px'
              this.style.boxShadow = 'none'
              this.style.backgroundColor = '#f5f5f5'
            }
          })

          wheelOption.addEventListener('click', function () {
            // 移除其他輪框的選中狀態
            document.querySelectorAll('.wheel-option').forEach((opt) => {
              opt.classList.remove('selected')
              opt.style.width = '100px'
              opt.style.height = '100px'
              opt.style.border = 'none'
              opt.style.boxShadow = 'none'
              opt.style.backgroundColor = '#f5f5f5'
            }) // 設置當前輪框為選中
            this.classList.add('selected')
            this.style.width = '112px'
            this.style.height = '112px'
            this.style.border = '3px solid #ffce60'
            this.style.boxShadow = '0 0 12px rgba(255, 206, 96, 0.7)'
            this.style.backgroundColor = '#fffbeb'

            const wheelNumber = this.dataset.wheelNumber
            selectedWheelIndex = index

            // 更新套件選項以反映新輪框和當前顏色
            const currentCar = sidebarCarTitle.textContent
            if (
              currentCarConfiguration &&
              currentCarConfiguration.colors.length > 0
            ) {
              const selectedColor =
                currentCarConfiguration.colors[selectedColorIndex] ||
                currentCarConfiguration.colors[0]
              updatePackageOptions(
                currentCar,
                selectedColor.colorCode,
                wheelNumber
              )
            }
          })
        })
    } // 綁定套件選擇事件 - 簡化版本，只處理圖片
    function bindPackageSelectionEvents() {
      document
        .querySelectorAll('.package-option')
        .forEach((packageOption, index) => {
          // 添加 hover 效果
          packageOption.addEventListener('mouseenter', function () {
            if (!this.classList.contains('selected')) {
              this.style.transform = 'translateY(-5px)'
              this.style.boxShadow = '0 8px 16px rgba(0, 0, 0, 0.1)'
              this.style.backgroundColor = '#fffbeb'
            }
          })

          packageOption.addEventListener('mouseleave', function () {
            if (!this.classList.contains('selected')) {
              this.style.transform = 'none'
              this.style.boxShadow = 'none'
              this.style.backgroundColor = '#f5f5f5'
            }
          })

          packageOption.addEventListener('click', function () {
            // 移除其他套件的選中狀態
            document.querySelectorAll('.package-option').forEach((opt) => {
              opt.classList.remove('selected')
              opt.style.transform = 'none'
              opt.style.boxShadow = 'none'
              opt.style.backgroundColor = '#f5f5f5'
              opt.style.border = 'none'
            })

            // 設置當前套件為選中
            this.classList.add('selected')
            this.style.transform = 'translateY(-5px)'
            this.style.boxShadow = '0 0 12px rgba(255, 206, 96, 0.7)'
            this.style.backgroundColor = '#fffbeb'
            this.style.border = '3px solid #ffce60'
          })
        })
    }

    // 接收來自 window 的自定義事件
    window.addEventListener('openCarConfig', (event) => {
      if (event.detail && event.detail.carName) {
        openConfigModal(event.detail.carName)
      }
    }) // 開啟燈窗的函數
    function openConfigModal(carName) {
      if (!modal) return

      const normalizedCarName = normalizeCarName(carName)

      // 獲取車型的完整配置
      currentCarConfiguration = getCarConfiguration(normalizedCarName)

      // 設置側邊欄車型名稱
      sidebarCarTitle.textContent = normalizedCarName // 獲取車輛圖片
      const imagePath = getCarImage(normalizedCarName)
      if (imagePath) {
        sidebarCarImage.src = imagePath
        sidebarCarImage.alt = normalizedCarName
        sidebarCarImage.dataset.currentCar = normalizedCarName
      } else {
        console.warn(
          `⚠️ 找不到車型 "${normalizedCarName}" 的圖片，使用默認圖片`
        )
        sidebarCarImage.src = '/img/taycan.png'
      }

      // 動態更新顏色和輪框選項
      updateColorOptions(normalizedCarName) // 如果有可用顏色，使用第一個顏色更新輪框選項
      if (
        currentCarConfiguration &&
        currentCarConfiguration.colors.length > 0
      ) {
        const firstColor = currentCarConfiguration.colors[0]
        updateWheelOptions(normalizedCarName, firstColor.colorCode)

        // 初始化套件選項
        updatePackageOptions(normalizedCarName, firstColor.colorCode, 1)
      }

      // 動態更新技術規格 (替代原本的靜態更新)
      updateTechnicalSpecs(normalizedCarName)

      // 更新比較表格
      updateComparisonTable(normalizedCarName)

      modal.style.display = 'block'
      document.body.style.overflow = 'hidden' // 防止背景滾動

      // 重置為默認 TAB (配置車輛)
      activateTab('configure')

      // 確保所有 Splide 輪播到第一張
      Object.values(splideSliders).forEach((slider) => {
        if (slider && typeof slider.go === 'function') {
          slider.go(0)
        }
      })

      // 彈窗顯示後重新初始化輪播，解決初始隱藏狀態下的問題
      setTimeout(() => {
        Object.values(splideSliders).forEach((slider) => {
          if (slider && typeof slider.refresh === 'function') {
            slider.refresh()
            // 確保從第一張開始展示
            slider.go(0)
          }
        })
      }, 100)
    }

    // 點擊燈窗外部關閉
    window.addEventListener('click', function (event) {
      if (event.target === modal) {
        modal.style.display = 'none'
        document.body.style.overflow = 'auto'
      }
    })

    // TAB 切換功能
    const tabButtons = document.querySelectorAll('.tab-button')
    const tabContents = document.querySelectorAll('.tab-content')

    function activateTab(tabId) {
      // 移除所有 tab 按鈕的 active 類別
      tabButtons.forEach((button) => {
        button.classList.remove('active')
      })

      // 移除所有 tab 內容的 active 類別
      tabContents.forEach((content) => {
        content.classList.remove('active')
      })

      // 激活所選 tab 的按鈕
      const activeButton = document.querySelector(
        `.tab-button[data-tab="${tabId}"]`
      )
      if (activeButton) {
        activeButton.classList.add('active')
      }

      // 激活所選 tab 的內容
      const activeContent = document.getElementById(`${tabId}-tab`)
      if (activeContent) {
        activeContent.classList.add('active')
      } // 如果是配置車輛 TAB，確保所有 Splide 滑塊刷新
      if (tabId === 'configure') {
        setTimeout(() => {
          Object.values(splideSliders).forEach((slider) => {
            if (slider && typeof slider.refresh === 'function') {
              slider.refresh()
            }
          }) // 確保顏色和輪框選項是最新的
          const currentCar = sidebarCarTitle.textContent
          if (currentCar && currentCarConfiguration) {
            updateColorOptions(currentCar)
            if (currentCarConfiguration.colors.length > 0) {
              const selectedColor =
                currentCarConfiguration.colors[selectedColorIndex] ||
                currentCarConfiguration.colors[0]
              updateWheelOptions(currentCar, selectedColor.colorCode)

              // 更新套件選項
              const currentWheelNumber = selectedWheelIndex + 1
              updatePackageOptions(
                currentCar,
                selectedColor.colorCode,
                currentWheelNumber
              )
            }
          }
        }, 50)
      }

      // 如果切換到比較頁籤，更新比較表格
      if (tabId === 'compare') {
        const currentCar = sidebarCarTitle.textContent
        updateComparisonTable(currentCar)
      }

      // 如果切換到技術規格頁籤，更新技術規格內容
      if (tabId === 'technical') {
        const currentCar = sidebarCarTitle.textContent
        updateTechnicalSpecs(currentCar)
      }
    }

    // 綁定 tab 按鈕點擊事件
    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const tabId = button.getAttribute('data-tab')
        activateTab(tabId)
      })
    })

    // Initialize Splide
    const commonOptions = {
      type: 'slide',
      perPage: 3, // 確保每次顯示恰好三個選項
      perMove: 1,
      gap: '1rem', // 增加間距以改善視覺效果
      pagination: false,
      arrows: true, // 啟用箭頭導航
      drag: true,
      padding: {
        left: '0', // 移除左右內邊距以確保顯示正好三個項目
        right: '0',
      },
      focus: 'center', // 確保內容居中顯示
      trimSpace: false, // 禁止修剪空間以確保顯示三個項目
      autoWidth: false, // 禁用自動寬度
      fixedWidth: false, // 禁用固定寬度
      easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
      classes: {
        arrows: 'splide__arrows',
        arrow: 'splide__arrow',
        prev: 'splide__arrow--prev',
        next: 'splide__arrow--next',
      },
      start: 0, // 確保從第一張開始
      breakpoints: {
        768: {
          perPage: 2, // 平板上顯示2個
        },
        450: {
          perPage: 1, // 手機上顯示1個
        },
      },
    } // 為顏色選擇器設置特殊選項
    const colorOptions = {
      ...commonOptions,
      gap: '1.5rem',
      perPage: 5,
      focus: 'center',
      padding: {
        left: '2rem',
        right: '2rem',
      },
      breakpoints: {
        768: {
          perPage: 3,
          gap: '1rem',
        },
        450: {
          perPage: 2,
          gap: '0.5rem',
        },
      },
    }
    const packageOptions = {
      ...commonOptions,
      perPage: 3, // 套件選項每頁顯示4個
      gap: '1rem',
      padding: {
        left: '0rem',
        right: '0rem',
      },
      breakpoints: {
        768: {
          perPage: 3,
          gap: '1rem',
        },
        450: {
          perPage: 2,
          gap: '0.5rem',
        },
      },
    }

    // 初始化所有輪播 (移除套件滑塊初始化)
    let splideSliders = {}

    try {
      // 確保DOM元素存在再進行初始化
      if (document.querySelector('.color-slider')) {
        splideSliders.color = new Splide('.color-slider', colorOptions)
        splideSliders.color.mount()
        splideSliders.color.go(0) // 確保從第一張開始
      }

      if (document.querySelector('.wheel-slider')) {
        splideSliders.wheel = new Splide('.wheel-slider', packageOptions)
        splideSliders.wheel.mount()
        splideSliders.wheel.go(0)
      }

      if (document.querySelector('.seat-slider')) {
        splideSliders.seat = new Splide('.seat-slider', packageOptions)
        splideSliders.seat.mount()
        splideSliders.seat.go(0)
      }
      if (document.querySelector('.interior-slider')) {
        splideSliders.interior = new Splide('.interior-slider', commonOptions)
        splideSliders.interior.mount()
        splideSliders.interior.go(0)
      } // 確保在視窗大小變化時重新計算佈局，但保持在當前選擇的位置
      window.addEventListener('resize', () => {
        Object.values(splideSliders).forEach((slider) => {
          if (slider && typeof slider.refresh === 'function') {
            const currentIndex = slider.index
            slider.refresh()
            slider.go(currentIndex) // 保持在當前選擇的項目
          }
        }) // 重新應用套件選項的響應式樣式 - 簡化版本
        const packageOptions = document.querySelectorAll('.package-option')

        packageOptions.forEach((option) => {
          // 套件選項現在是固定尺寸的圖片容器，不需要響應式調整
          // 保持固定的 240x140 尺寸
          option.style.width = '240px'
          option.style.height = '140px'
        })
      })

      // 延遲檢查並修復箭頭樣式和事件
      setTimeout(() => {
        document.querySelectorAll('.splide__arrow').forEach((arrow) => {
          // 確保箭頭可見並正確定位
          arrow.style.opacity = '1'
          arrow.style.zIndex = '10'

          // 為箭頭添加額外點擊事件（用於除錯和確保功能正常）
          arrow.addEventListener('click', function (e) {
            e.stopPropagation() // 阻止事件冒泡
          })
        })
      }, 200) // 延遲以確保DOM完全渲染
    } catch (error) {
      console.error('初始化Splide輪播時出錯:', error)
    } // 選項點擊事件處理（僅保留座椅、內裝和套件選項）
    const handleOptionClick = (optionClass) => {
      document.querySelectorAll(`.${optionClass}`).forEach((option) => {
        option.addEventListener('click', function () {
          document.querySelectorAll(`.${optionClass}`).forEach((opt) => {
            opt.classList.remove('selected')
          })
          this.classList.add('selected')
        })
      })
    } // 綁定座椅和內裝選項的點擊事件（顏色、輪框和套件選項由動態函數處理）
    ;['seat-option', 'interior-option'].forEach(handleOptionClick)

    // 更新比較表格
    function updateComparisonTable(selectedCar) {
      const tableHeader = document.getElementById('comparisonTableHeader')
      const tableBody = document.getElementById('comparisonTableBody')

      if (!tableHeader || !tableBody) {
        console.error('比較表格元素不存在')
        return
      }

      tableHeader.innerHTML = '<th>Parameters</th>'
      tableBody.innerHTML = ''

      const normalizedSelectedCar = normalizeCarName(selectedCar)
      const screenWidth = window.innerWidth
      let carsToCompareCount = screenWidth <= 768 ? 2 : 4

      if (screenWidth <= 450) {
        carsToCompareCount = 1
      }

      const carsToCompare = getComparisonCars(
        normalizedSelectedCar,
        carsToCompareCount
      )

      // 生成表頭
      carsToCompare.forEach((car) => {
        const th = document.createElement('th')
        th.textContent = car
        tableHeader.appendChild(th)
      })

      // 生成表格內容
      comparisonParams.forEach((param) => {
        const row = document.createElement('tr')

        const paramCell = document.createElement('td')
        paramCell.textContent = param.label
        row.appendChild(paramCell)

        carsToCompare.forEach((car) => {
          const valueCell = document.createElement('td')
          const specs = getCarSpecs(car)

          if (specs && specs[param.key]) {
            valueCell.textContent = specs[param.key]
          } else {
            valueCell.textContent = 'N/A'
            console.warn(`車型 ${car} 缺少參數: ${param.key}`)
          }
          row.appendChild(valueCell)
        })

        tableBody.appendChild(row)
      })
    }

    // 動態生成技術規格內容 - 簡化版本，依賴全局樣式
    function updateTechnicalSpecs(selectedCar) {
      const specsGrid = document.getElementById('specsGrid')
      if (!specsGrid) {
        console.error('技術規格容器不存在')
        return
      }

      // 清空現有內容
      specsGrid.innerHTML = ''

      const normalizedCarName = normalizeCarName(selectedCar)
      const specs = getCarSpecs(normalizedCarName)

      if (!specs) {
        const errorMessage = document.createElement('div')
        errorMessage.className = 'error-message'
        errorMessage.style.cssText = `
          padding: 20px;
          text-align: center;
          color: #666;
          font-style: italic;
          background-color: #f9f9f9;
          border-radius: 8px;
          grid-column: 1 / -1;
        `
        errorMessage.textContent = `找不到 ${normalizedCarName} 的技術規格資料`
        specsGrid.appendChild(errorMessage)
        return
      }

      // 定義規格分類和對應的標籤
      const specCategories = [
        {
          title: 'Power System',
          specs: [
            {key: 'driveSystem', label: 'Drive System'},
            {key: 'power', label: 'Maximum Power'},
            {key: 'torque', label: 'Maximum Torque'},
          ],
        },
        {
          title: 'Performance',
          specs: [
            {key: 'acceleration', label: '0-100 km/h'},
            {key: 'topSpeed', label: 'Top Speed'},
          ],
        },
        {
          title: 'Battery & Range',
          specs: [
            {key: 'batteryCapacity', label: 'Battery Capacity'},
            {key: 'range', label: 'Maximum Range'},
          ],
        },
        {
          title: 'Dimensions',
          specs: [
            {key: 'length', label: 'Length'},
            {key: 'width', label: 'Width'},
            {key: 'height', label: 'Height'},
            {key: 'wheelbase', label: 'Wheelbase'},
          ],
        },
      ]

      // 動態生成規格卡片，依賴全局樣式
      specCategories.forEach((category) => {
        const specItem = document.createElement('div')
        specItem.className = 'spec-item'

        const title = document.createElement('h3')
        title.textContent = category.title
        specItem.appendChild(title)

        category.specs.forEach((spec) => {
          const p = document.createElement('p')
          const value = specs[spec.key] || 'N/A'

          const label = document.createElement('span')
          label.textContent = spec.label + ':'

          const valueSpan = document.createElement('span')
          valueSpan.className = 'spec-value'
          valueSpan.textContent = value

          p.appendChild(label)
          p.appendChild(valueSpan)
          specItem.appendChild(p)
        })

        specsGrid.appendChild(specItem)
      })
    }

    // 選擇要比較的車型
    function getComparisonCars(selectedCar, count) {
      count = Math.max(2, Math.min(count || 4, allCarModels.length))
      let result = [selectedCar]

      let selectedGroups = []
      for (const [group, cars] of Object.entries(carGroups)) {
        if (cars.includes(selectedCar)) {
          selectedGroups.push(group)
        }
      }

      const getComparisonPriority = (selectedCar) => {
        const carSeries = selectedCar.startsWith('Taycan') ? 'Taycan' : 'Macan'
        const priorityGroups = []

        for (const group of selectedGroups) {
          if (group.includes('Electric') && carGroups[group].length > 1) {
            priorityGroups.push(group)
          }
        }

        for (const [group, cars] of Object.entries(carGroups)) {
          if (group.includes(carSeries) && !selectedGroups.includes(group)) {
            priorityGroups.push(group)
          }
        }

        const otherSeries = carSeries === 'Taycan' ? 'Macan' : 'Taycan'
        for (const [group, cars] of Object.entries(carGroups)) {
          if (group.includes(otherSeries)) {
            priorityGroups.push(group)
          }
        }

        return priorityGroups
      }

      const priorityGroups = getComparisonPriority(selectedCar)

      for (const group of priorityGroups) {
        if (result.length < count && carGroups[group]) {
          for (const car of carGroups[group]) {
            if (!result.includes(car) && result.length < count) {
              result.push(car)
              break
            }
          }
        }
      }

      if (result.length < count) {
        for (const car of allCarModels) {
          if (!result.includes(car) && result.length < count) {
            result.push(car)
          }
        }
      }

      return result.slice(0, count)
    }

    // 添加視窗大小變化的事件監聽器，以便在視窗大小改變時更新表格
    let resizeTimeout
    window.addEventListener('resize', () => {
      // 使用 debounce 技術防止過於頻繁地更新
      if (resizeTimeout) {
        clearTimeout(resizeTimeout)
      }
      resizeTimeout = setTimeout(() => {
        // 僅當比較標籤已啟用時才更新表格
        const compareTab = document.getElementById('compare-tab')
        if (compareTab && compareTab.classList.contains('active')) {
          const currentCar = sidebarCarTitle.textContent
          updateComparisonTable(currentCar)
        }
      }, 250) // 等待 250ms 再觸發更新
    }) // 測試函數 - 可在需要時呼叫以驗證映射和數據
  })
</script>
