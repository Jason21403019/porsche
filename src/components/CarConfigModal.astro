---

<!-- Add Splide CSS in head -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css"
/>

<!-- Modal Structure -->
<div id="carConfigModal" class="modal">
  <div class="modal-content">
    <div class="modal-body">
      <!-- Car Info Section at modal-body level -->
      <div class="car-info">
        <h3 id="sidebarCarTitle">Taycan</h3>
      </div>

      <!-- Car Image directly without wrapper -->
      <img
        id="sidebarCarImage"
        src="/img/taycan.png"
        alt="Car Model"
        class="car-info__image car-info__image--mobile car-info__image--small-mobile"
      />

      <!-- Left side 30% area: Menu -->
      <div class="config-sidebar">
        <!-- Menu in TAB style -->
        <div class="sidebar-tabs">
          <button class="tab-button active" data-tab="configure"
            >Configure Vehicle</button
          >
          <button class="tab-button" data-tab="technical"
            >Technical Specs</button
          >
          <button class="tab-button" data-tab="compare">Model Comparison</button
          >
          <!-- 未來功能：更多車輛頁籤 
          <button class="tab-button" data-tab="more">More Vehicles</button>
          -->
        </div>
      </div>

      <!-- Right side 70% area: Content based on selected TAB -->
      <div class="config-content">
        <!-- Configure Vehicle TAB content (original configuration block) -->
        <div class="tab-content active" id="configure-tab">
          <div class="config-grid">
            <!-- Color Selection Block - First row, first column -->
            <div class="config-section">
              <h3>Color Selection</h3>
              <div class="splide color-slider">
                <div class="splide__track">
                  <ul class="splide__list">
                    <li class="splide__slide">
                      <div
                        class="color-option"
                        style="background-color: #fff"
                        data-color="white"
                      >
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div
                        class="color-option"
                        style="background-color: #000"
                        data-color="black"
                      >
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div
                        class="color-option"
                        style="background-color: #d4d4d4"
                        data-color="silver"
                      >
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div
                        class="color-option"
                        style="background-color: #c0c0c0"
                        data-color="metallic"
                      >
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div
                        class="color-option"
                        style="background-color: #960018"
                        data-color="red"
                      >
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div
                        class="color-option"
                        style="background-color: #0147ab"
                        data-color="blue"
                      >
                      </div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Wheel Selection Block -->
            <div class="config-section">
              <h3>Wheel Selection</h3>
              <div class="splide wheel-slider">
                <div class="splide__track">
                  <ul class="splide__list">
                    <li class="splide__slide">
                      <div class="wheel-option">
                        <img src="/img/wheel1.png" alt="Wheel 1" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="wheel-option">
                        <img src="/img/wheel2.png" alt="Wheel 2" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="wheel-option">
                        <img src="/img/wheel3.png" alt="Wheel 3" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="wheel-option">
                        <img src="/img/wheel1.png" alt="Wheel 1" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="wheel-option">
                        <img src="/img/wheel2.png" alt="Wheel 2" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="wheel-option">
                        <img src="/img/wheel3.png" alt="Wheel 3" />
                      </div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Seat Selection Block -->
            <div class="config-section">
              <h3>Seat Selection</h3>
              <div class="splide seat-slider">
                <div class="splide__track">
                  <ul class="splide__list">
                    <li class="splide__slide">
                      <div class="seat-option">
                        <img src="/img/seat1.png" alt="Seat 1" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="seat-option">
                        <img src="/img/seat2.png" alt="Seat 2" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="seat-option">
                        <img src="/img/seat3.png" alt="Seat 3" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="seat-option">
                        <img src="/img/seat1.png" alt="Seat 1" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="seat-option">
                        <img src="/img/seat2.png" alt="Seat 2" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="seat-option">
                        <img src="/img/seat3.png" alt="Seat 3" />
                      </div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Interior Materials Block -->
            <div class="config-section">
              <h3>Interior Materials</h3>
              <div class="splide interior-slider">
                <div class="splide__track">
                  <ul class="splide__list">
                    <li class="splide__slide">
                      <div class="interior-option">
                        <img src="/img/interior1.png" alt="Interior 1" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="interior-option">
                        <img src="/img/interior2.png" alt="Interior 2" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="interior-option">
                        <img src="/img/interior3.png" alt="Interior 3" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="interior-option">
                        <img src="/img/interior1.png" alt="Interior 1" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="interior-option">
                        <img src="/img/interior2.png" alt="Interior 2" />
                      </div>
                    </li>
                    <li class="splide__slide">
                      <div class="interior-option">
                        <img src="/img/interior3.png" alt="Interior 3" />
                      </div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Optional Packages Block (static display) -->
            <div class="config-section full-width">
              <h3>Optional Packages</h3>
              <div class="package-container">
                <div class="package-option">
                  <img src="/img/car1.png" alt="Package 1" />
                </div>
                <div class="package-option">
                  <img src="/img/car2.png" alt="Package 2" />
                </div>
                <div class="package-option">
                  <img src="/img/car3.png" alt="Package 3" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Technical Specs TAB content -->
        <div class="tab-content" id="technical-tab">
          <div class="technical-specs">
            <h2>Technical Specifications</h2>
            <div class="specs-grid">
              <div class="spec-item">
                <h3>Power System</h3>
                <p>
                  Drive System: <span id="techDriveSystem"
                    >Rear-wheel drive</span
                  >
                </p>
                <p>
                  Maximum Power: <span id="techPower">300 kW / 408 PS</span>
                </p>
                <p>Maximum Torque: <span id="techTorque">345 Nm</span></p>
              </div>
              <div class="spec-item">
                <h3>Performance</h3>
                <p>
                  0-100 km/h: <span id="techAcceleration">5.4 seconds</span>
                </p>
                <p>Top Speed: <span id="techTopSpeed">230 km/h</span></p>
              </div>
              <div class="spec-item">
                <h3>Battery</h3>
                <p>Capacity: <span id="techBatteryCapacity">79.2 kWh</span></p>
                <p>Charging Time (Fast Charge): 22.5 minutes (5% to 80%)</p>
                <p>Maximum Range: <span id="techRange">431 km (WLTP)</span></p>
              </div>
              <div class="spec-item">
                <h3>Dimensions</h3>
                <p>Length: 4,963 mm</p>
                <p>Width: 1,966 mm</p>
                <p>Height: 1,378 mm</p>
                <p>Wheelbase: 2,900 mm</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Model Comparison TAB content -->
        <div class="tab-content" id="compare-tab">
          <div class="compare-models">
            <h2>Model Comparison</h2>
            <div class="compare-table">
              <table id="modelComparisonTable">
                <thead>
                  <tr id="comparisonTableHeader">
                    <th>Parameters</th>
                    <!-- 動態生成的表頭 -->
                  </tr>
                </thead>
                <tbody id="comparisonTableBody">
                  <!-- 動態生成的表格內容 -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- 未來功能：更多車輛 TAB 內容 
        <div class="tab-content" id="more-tab">
          <div class="more-cars">
            <h2>More Vehicles</h2>
            <div class="cars-grid">
              <div class="car-card">
                <img src="/img/taycan.png" alt="Taycan" />
                <h3>Taycan</h3>
                <p>Starting from: NT$ 4,580,000</p>
                <button class="car-config-btn">Configure Vehicle</button>
              </div>
              <div class="car-card">
                <img src="/img/911.png" alt="911" />
                <h3>911</h3>
                <p>Starting from: NT$ 5,340,000</p>
                <button class="car-config-btn">Configure Vehicle</button>
              </div>
              <div class="car-card">
                <img src="/img/panamera.png" alt="Panamera" />
                <h3>Panamera</h3>
                <p>Starting from: NT$ 4,980,000</p>
                <button class="car-config-btn">Configure Vehicle</button>
              </div>
              <div class="car-card">
                <img src="/img/cayenne.png" alt="Cayenne" />
                <h3>Cayenne</h3>
                <p>Starting from: NT$ 3,880,000</p>
                <button class="car-config-btn">Configure Vehicle</button>
              </div>
            </div>
          </div>
        </div>
        -->
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  /* Modal Styles */
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    overflow-y: auto;

    .modal-content {
      background-color: #f5f5f5;
      margin: 3% auto; // 調整為較小的上下邊距
      width: 90%;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      position: relative;
      height: 90vh; // 控制最大高度不超過視口的94%

      @media (max-width: 768px) {
        width: 95%;
        margin: 2% auto;
        height: 96vh;
      }

      // 確保modal-content下所有div元素都繼承父層寬度
      & > div,
      & div {
        width: 100%;
        box-sizing: border-box;
      }

      .modal-body {
        padding: 0;
        display: flex;
        height: 100%; // 設定為100%以填滿modal-content
        min-height: auto; // 移除最小高度限制
        width: 100%;
        position: relative; // 作為定位參考點

        @media (max-width: 768px) {
          flex-direction: column;
        }

        .car-info {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 30%; // 調整高度，因為圖片已移出
          z-index: 10;
          pointer-events: none;
          h3 {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: #ffffff;
            position: relative;
            z-index: 10;
            pointer-events: auto; // 恢復標題的點擊事件

            @media (max-width: 768px) {
              font-size: 1.5rem;
              margin-bottom: 10px;
              text-align: center;
            }

            @media (max-width: 450px) {
              font-size: 1.3rem;
              margin-bottom: 8px;
            }
          }
        }

        .car-info__image {
          position: absolute;
          bottom: 0%;
          left: 10%;
          width: 40%;
          height: auto;
          object-fit: contain;
          display: block;
          z-index: 9;
          pointer-events: auto;
          @media screen and (max-width: 1024px) {
            width: 39%;
            left: 0%;
          }
          @media (max-width: 768px) {
            width: 70%;
            left: 15%;
            bottom: 58%;
          }
        }

        .config-sidebar {
          width: 30%;
          background: linear-gradient(to bottom, #282828, #eec976);
          padding: 20px;
          border-right: 1px solid #e0e0e0;
          overflow-y: auto; // 內容過多時可滾動
          position: relative; // 使內容區域相對於側邊欄定位
          padding-top: 20px; // 為車輛資訊留出空間

          @media (max-width: 768px) {
            width: 100%;
            height: 50%;
            min-height: 180px;
            padding: 15px;
            border-right: none;
            border-bottom: 1px solid #e0e0e0;
            padding-top: 15px;
          }

          @media (max-width: 450px) {
            height: 25%;
            min-height: 150px;
            padding: 10px;
            padding-top: 10px;
          }

          /* 修改選單為 TAB 風格 */
          .sidebar-tabs {
            width: 100%;
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;

            @media (max-width: 768px) {
              margin-top: 10px;
              flex-direction: row;
              flex-wrap: wrap;
              justify-content: center;
              gap: 5px;
            }

            .tab-button {
              width: 100%;
              padding: 12px 15px;
              background-color: rgba(255, 255, 255, 0.1);
              color: #ffffff;
              border: none;
              border-radius: 6px;
              font-size: 1.1rem;
              font-weight: 500;
              text-align: left;
              cursor: pointer;
              transition: all 0.3s ease;

              @media (max-width: 768px) {
                padding: 8px 12px;
                font-size: 0.9rem;
                flex: 1 1 auto;
                text-align: center;
                min-width: 120px;
              }

              @media (max-width: 450px) {
                padding: 6px 10px;
                font-size: 0.8rem;
                min-width: 100px;
              }

              &:hover {
                background-color: rgba(255, 255, 255, 0.2);
              }

              &.active {
                background-color: #ffce60;
                color: #000;
                font-weight: 600;
              }
            }
          }
        }

        .config-content {
          width: 70%;
          padding: 15px; // 減少內邊距
          position: relative;
          overflow-y: auto; // 內容過多時可滾動
          background-color: #fff;

          @media (max-width: 768px) {
            width: 100%;
            height: 70%;
            padding: 12px;
          }

          @media (max-width: 450px) {
            height: 75%;
            padding: 10px;
          }

          /* TAB 內容樣式 */
          .tab-content {
            width: 100%;
            display: none;
            padding: 10px;
            animation: fadeIn 0.5s ease;

            @media (max-width: 450px) {
              padding: 5px;
            }

            &.active {
              display: block;
            }
          }

          /* 技術規格 TAB 的樣式 */
          .technical-specs {
            width: 100%;
            h2 {
              font-size: 1.8rem;
              margin-bottom: 20px;
              color: #333;
              border-left: 5px solid #ffce60;
              padding-left: 15px;

              @media (max-width: 768px) {
                font-size: 1.5rem;
                margin-bottom: 15px;
              }

              @media (max-width: 450px) {
                font-size: 1.3rem;
                margin-bottom: 12px;
                padding-left: 10px;
              }
            }

            .specs-grid {
              width: 100%;
              display: grid;
              grid-template-columns: repeat(2, 1fr);
              gap: 20px;

              @media (max-width: 768px) {
                gap: 15px;
              }

              @media (max-width: 450px) {
                grid-template-columns: 1fr;
                gap: 10px;
              }

              .spec-item {
                width: 100%;
                background-color: #f8f8f8;
                border-radius: 8px;
                padding: 15px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);

                @media (max-width: 768px) {
                  padding: 12px;
                }

                @media (max-width: 450px) {
                  padding: 10px;
                }

                h3 {
                  font-size: 1.2rem;
                  margin-bottom: 10px;
                  color: #333;
                  border-bottom: 2px solid #ffce60;
                  padding-bottom: 5px;

                  @media (max-width: 768px) {
                    font-size: 1.1rem;
                  }

                  @media (max-width: 450px) {
                    font-size: 1rem;
                    margin-bottom: 8px;
                  }
                }

                p {
                  margin: 5px 0;
                  color: #555;
                  font-size: 1rem;

                  @media (max-width: 450px) {
                    font-size: 0.9rem;
                    margin: 4px 0;
                  }
                }
              }
            }
          }

          /* 車型比較 TAB 的樣式 */
          .compare-models {
            width: 100%;
            h2 {
              font-size: 1.8rem;
              margin-bottom: 20px;
              color: #333;
              border-left: 5px solid #ffce60;
              padding-left: 15px;

              @media (max-width: 768px) {
                font-size: 1.5rem;
                margin-bottom: 15px;
              }

              @media (max-width: 450px) {
                font-size: 1.3rem;
                margin-bottom: 12px;
                padding-left: 10px;
              }
            }

            .compare-table {
              width: 100%;
              overflow-x: auto;

              @media (max-width: 450px) {
                margin: 0 -5px; // 增加負邊距以利用更多空間
              }

              table {
                width: 100%;
                border-collapse: collapse;

                th,
                td {
                  padding: 12px 15px;
                  text-align: left;
                  border-bottom: 1px solid #ddd;
                }

                th {
                  background-color: #f2f2f2;
                  color: #333;
                  font-weight: 600;
                }

                tr:nth-child(even) {
                  background-color: #f9f9f9;
                }

                tr:hover {
                  background-color: #f1f1f1;
                }
              }
            }
          }

          /* 未來功能：更多車輛 TAB 的樣式 
          .more-cars {
            h2 {
              font-size: 1.8rem;
              margin-bottom: 20px;
              color: #333;
              border-left: 5px solid #ffce60;
              padding-left: 15px;
            }

            .cars-grid {
              display: grid;
              grid-template-columns: repeat(2, 1fr);
              gap: 20px;

              .car-card {
                background-color: #f8f8f8;
                border-radius: 10px;
                padding: 15px;
                box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
                text-align: center;
                transition: transform 0.3s ease;

                &:hover {
                  transform: translateY(-5px);
                  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
                }

                img {
                  width: 100%;
                  height: auto;
                  max-height: 140px;
                  object-fit: contain;
                  margin-bottom: 10px;
                }

                h3 {
                  font-size: 1.4rem;
                  margin-bottom: 8px;
                  color: #333;
                }

                p {
                  color: #666;
                  margin-bottom: 15px;
                }

                .car-config-btn {
                  background-color: #ffce60;
                  color: #000;
                  border: none;
                  padding: 8px 15px;
                  border-radius: 5px;
                  font-weight: 600;
                  cursor: pointer;
                  transition: background-color 0.3s ease;

                  &:hover {
                    background-color: #e0b040;
                  }
                }
              }
            }
          }
          */

          .config-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-gap: 10px 8px; // 進一步減少格子間距
            height: auto; // 確保高度自適應
            overflow: visible; // 防止內容被裁切

            @media (max-width: 768px) {
              grid-gap: 8px 6px;
            }

            @media (max-width: 450px) {
              grid-template-columns: 1fr;
              grid-gap: 6px;
            }

            // 新增跨列元素的樣式
            .full-width {
              width: 80%;
              margin: 0 auto; // 居中顯示
              grid-column: span 2; // 跨越兩列

              @media (max-width: 768px) {
                width: 90%;
              }

              @media (max-width: 450px) {
                width: 100%;
                grid-column: span 1;
              }
            }

            @media (max-width: 1200px) {
              grid-template-columns: 1fr;

              .full-width {
                grid-column: span 1;
              }
            }
          }
        }
      }

      .config-section {
        width: 100%;
        margin-bottom: 10px; // 減少底部間距
        padding: 5px 0; // 減少上下內邊距
        box-sizing: border-box;
        border: none; // 移除邊框
        background-color: transparent; // 透明背景
        overflow: hidden; // 防止內容溢出

        h3 {
          font-size: 0.9rem; // 縮小標題
          margin-bottom: 5px; // 減少下方間距
          color: #333;
          font-weight: 600;
          border-left: 4px solid #ffce60;
          padding-left: 10px;
        }

        .slider-container {
          position: relative;
          width: 100%;
          margin-bottom: 10px; // 減少底部間距
          height: 160px; // 減少高度
          display: flex;
          align-items: center;

          .slider-button {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background-color: rgba(255, 255, 255, 0.8);
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 5;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            transition: all 0.3s;

            &:hover {
              background-color: #ffce60;
            }

            &.prev {
              left: 10px;
            }

            &.next {
              right: 10px;
            }
          }

          .slider-wrapper {
            display: flex;
            transition: transform 0.5s ease;
            padding: 10px 50px;
            width: 100%;
            justify-content: center;
          }
        }

        .color-slider {
          height: 120px;
          justify-content: center;
          gap: 20px;

          .color-option {
            width: 32px; // 縮小顏色選項
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid #ddd;
            flex: 0 0 auto;
