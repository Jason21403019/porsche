        power: '380 kW / 516 PS',
        torque: '820 Nm',
        acceleration: '4.1 seconds',
        topSpeed: '240 km/h',
        batteryCapacity: '100 kWh',
        range: '516 km (WLTP)',
      },
      'Macan GTS': {
        driveSystem: 'All-wheel drive',
        power: '440 kW / 598 PS',
        torque: '1130 Nm',
