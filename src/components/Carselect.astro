}

const cars = [
  {
    model: 'Taycan',
    image: carData.Taycan.image,
    className: 'car-image',
    stats: carData.Taycan.stats,
    models: carData.Taycan.models,
  },
  {
    model: 'Macan',
    image: carData.Macan.image,
    className: 'car-image',
    stats: carData.Macan.stats,
    models: carData.Macan.models,
  },
]
let isModelTaycan = true
const currentModel = isModelTaycan ? 'Taycan' : 'Macan'
const currentCar = cars.find((car) => car.model === currentModel) || cars[0]
---

<div class="wrapper">
  <section class="section animation-section">
    <div class="content-container">
      <div
        class="car-select"
        style={`background-color: ${isModelTaycan ? '#313131' : '#8c8c8c'}`}
      >
        <!-- ModelSwitch 組件內容 -->
        <div class="model-switch">
          <div class="indicator"></div>
          <button
            class={`switch-btn ${currentModel === 'Taycan' ? 'active' : ''}`}
            data-model="Taycan"
          >
            Taycan
          </button>
          <button
            class={`switch-btn ${currentModel === 'Macan' ? 'active' : ''}`}
            data-model="Macan"
          >
            Macan
          </button>
        </div>

        <h1 class="title" id="model-selection">Model Selection</h1>
        <img
          src={currentCar.image}
          alt="Car"
          class="car-image"
          id="main-car-image"
        />
      </div>

      <img src="/img/graycan.png" alt="Platform" class="platform-image" />
      <div class="circle circle-left">
        <div class="border_line"></div>
        <span class="number1">000</span>
        <span class="unit">km/h</span>
        <span class="speed">Extreme speed</span>
      </div>
      <div class="circle circle-right">
        <div class="border_line"></div>
        <span class="number2">0</span>
        <span class="unit2">s</span>
        <span class="speed2">0-100 km/h</span>
      </div>
      <div class="carousel-container">
        <!-- Carouselcar 組件內容 -->
        <div class="taycan-slider" id="car-slider">
          <div class="splide">
            <div class="splide__track">
              <div class="splide__list" id="car-list">
                {
                  currentCar.models.map((model) => (
                    <div class="splide__slide">
                      <div class="content-wrapper">
                        <h3 class="car-name">{model.name}</h3>
                        <div class="additional-content">
                          <p class="price">{model.price}</p>
                          <button class="view-more" data-car={model.name}>
                            See more
                          </button>
                        </div>
                        <div class="car-image-carousel">
                          <img src={model.image} alt={model.name} />
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      <svg style="visibility: hidden; position: absolute; width: 0; height: 0;">
        <path id="leftPath" d="M 0,0 C -100,-100 -100,-50 -550,-100"></path>
        <path id="rightPath" d="M 0,0 C 100,-100 100,-50 550,-200"></path>
      </svg>
    </div>
  </section>
</div>

<script>
  import gsap from 'gsap'
  import ScrollTrigger from 'gsap/ScrollTrigger'
  import {MotionPathPlugin} from 'gsap/MotionPathPlugin'
  import Splide from '@splidejs/splide'
  import '@splidejs/splide/css'

  gsap.registerPlugin(ScrollTrigger, MotionPathPlugin)

  // 效能優化：使用 WeakMap 來避免記憶體洩漏
  const animationTimelines = new Map()

  // 防抖函數
  function debounce(func: Function, wait: number) {
    let timeout: NodeJS.Timeout
    return function executedFunction(...args: any[]) {
      const later = () => {
        clearTimeout(timeout)
        func(...args)
      }
      clearTimeout(timeout)
      timeout = setTimeout(later, wait)
    }
  }

  // 錯誤處理包裝器
  function safeExecute(
    func: Function,
    errorMsg: string = 'Function execution failed'
  ) {
    try {
      return func()
    } catch (error) {
      console.warn(`${errorMsg}:`, error)
      return null
    }
  }

  const leftTarget = 250
  const rightTarget = 3.3

  // 定義全域變數
  let currentModel = 'Taycan'
  let splide = null
  let isInitialized = false

  // 移除重複的 carData 定義，直接使用前端腳本中的統一資料
  const carData = {
    Taycan: {
      image: '/img/redcar.png',
      stats: {maxSpeed: 250, acceleration: 3.3},
      models: [
        {
          name: 'Taycan',
          price: 'NTD 4,320,000',
          image: '/Taycan/taycan/01-02-Photoroom.png',
        },
        {
          name: 'Taycan 4',
          price: 'NTD 4,600,000',
          image: '/Taycan/taycan4/Taycan 4-1.png',
        },
        {name: 'Taycan 4s', price: 'NTD 5,320,000', image: '/img/taycan4s.png'},
        {
          name: 'Taycan GTS',
          price: 'NTD 6,580,000',
          image: '/img/taycan-gts.png',
        },
        {
          name: 'Taycan Turbo',
          price: 'NTD 7,680,000',
          image: '/img/taycan-turbo.png',
        },
        {
          name: 'Taycan Turbo S',
          price: 'NTD 9,250,000',
          image: '/img/Taycan-Turbo-S.png',
        },
        {
          name: 'Taycan Turbo GT',
          price: 'NTD 10,480,000',
          image: '/img/taycan-turbo-gt.png',
        },
        {
          name: 'Taycan Turbo GT with Wp',
          price: 'NTD 10,480,000',
          image: '/img/Taycan-Turbo-GT-with-Weissach-Package.png',
        },
      ],
    },
    Macan: {
      image: '/Macan/macan/1-02.png',
      stats: {maxSpeed: 220, acceleration: 4.1},
      models: [
        {name: 'Macan', price: 'NTD 3,200,000', image: '/Macan/macan/1-02.png'},
        {
          name: 'Macan 4',
          price: 'NTD 3,500,000',
          image: '/Macan/Macan 4 Electric/Macan 4 Electric.png',
        },
        {
          name: 'Macan S',
          price: 'NTD 4,100,000',
          image: '/Macan/macan s/01-02-Photoroom.png',
        },
        {
          name: 'Macan GTS',
          price: 'NTD 4,800,000',
          image: '/Macan/macan gts/01-02.png',
        },
        {
          name: 'Macan Turbo',
          price: 'NTD 5,500,000',
          image: '/img/Macan-Turbo-Electric.png',
        },
      ],
    },
  }

  // 優化圖片載入確認函數
  function checkImageLoaded(selector: string, timeout: number = 10000) {
    return new Promise((resolve, reject) => {
      const img = document.querySelector(selector) as HTMLImageElement
      if (!img) {
        reject(new Error(`Image element ${selector} not found`))
        return
      }

      // 檢查是否已經載入
      if (img.complete && img.naturalHeight !== 0) {
        resolve(img)
        return
      }

      // 設置載入事件
      const onLoad = () => {
        cleanup()
        resolve(img)
      }

      const onError = () => {
        cleanup()
        console.warn(`Failed to load image: ${img.src}`)
        resolve(img) // 即使失敗也繼續，避免阻塞
      }

      const onTimeout = () => {
        cleanup()
        console.warn(`Image loading timeout: ${img.src}`)
        resolve(img)
      }

      const cleanup = () => {
        img.removeEventListener('load', onLoad)
        img.removeEventListener('error', onError)
        clearTimeout(timeoutId)
      }

      img.addEventListener('load', onLoad)
      img.addEventListener('error', onError)
      const timeoutId = setTimeout(onTimeout, timeout)
    })
  }

  // 圖片預載入函數
  function preloadImages(imageUrls: string[]) {
    return Promise.allSettled(
      imageUrls.map((url) => {
        return new Promise((resolve, reject) => {
          const img = new Image()
          img.onload = () => resolve(img)
          img.onerror = () => reject(new Error(`Failed to preload: ${url}`))
          img.src = url
        })
      })
    )
  }

  // ModelSwitch 功能
  function initModelSwitch() {
    const buttons = document.querySelectorAll('.switch-btn')
    const indicator = document.querySelector('.indicator') as HTMLElement
    const carSelect = document.querySelector('.car-select') as HTMLElement

    if (!buttons.length || !indicator || !carSelect) {
      console.warn('ModelSwitch elements not found')
      return
    }

    function updateIndicator(model: string) {
      const activeButton = document.querySelector(
        `.switch-btn[data-model="${model}"]`
      ) as HTMLElement
      if (activeButton) {
        const index = [...buttons].indexOf(activeButton)
        if (indicator) {
          // 使用 GSAP 動畫提升效能
          gsap.to(indicator, {
            x: `${index * 100}%`,
            duration: 0.3,
            ease: 'power2.out',
          })
        }

        // 延遲更新按鈕狀態以配合動畫
        setTimeout(() => {
          buttons.forEach((btn) => btn.classList.remove('active'))
          activeButton.classList.add('active')
        }, 50)
      }
    }

    // 防抖的模型切換函數
    const debouncedSwitchModel = debounce((model: string) => {
      if (model === currentModel) return

      currentModel = model
      const data = carData[model]
      if (!data) return

      const newBgColor = model === 'Taycan' ? '#313131' : '#8c8c8c'

      // 停止之前的動畫
      const prevTimeline = animationTimelines.get('modelSwitch')
      if (prevTimeline) {
        prevTimeline.kill()
      }

      // 創建新的動畫時間線
      const timeline = gsap.timeline()
      animationTimelines.set('modelSwitch', timeline)

      // 背景顏色動畫
      timeline.to(carSelect, {
        backgroundColor: newBgColor,
        duration: 0.5,
        ease: 'power2.out',
      })

      // 主車輛圖片動畫
      const mainCarImage = document.getElementById(
        'main-car-image'
      ) as HTMLImageElement
      if (mainCarImage) {
        timeline
          .to(
            mainCarImage,
            {
              opacity: 0.3,
              scale: 0.8,
              duration: 0.3,
              onComplete: () => {
                mainCarImage.src = data.image
              },
            },
            0
          )
          .to(mainCarImage, {
            opacity: 1,
            scale: 1,
            duration: 0.3,
            ease: 'back.out(1.7)',
          })
      }

      // 更新統計數據和輪播
      updateStats(data.stats.maxSpeed, data.stats.acceleration)
      updateCarousel(data.models)
      updateIndicator(model)
    }, 300)

    function updateStats(maxSpeed: number, acceleration: number) {
      // 停止之前的統計動畫
      const prevStatsTimeline = animationTimelines.get('stats')
      if (prevStatsTimeline) {
        prevStatsTimeline.kill()
      }

      const statsTimeline = gsap.timeline()
      animationTimelines.set('stats', statsTimeline)

      statsTimeline.to('.circle .number1', {
        duration: 1,
        innerHTML: maxSpeed,
        snap: {innerHTML: 1},
        ease: 'power2.inOut',
      })

      let count = {
        val: parseFloat(
          (document.querySelector('.circle .number2') as HTMLElement)
            ?.innerText || '0'
        ),
      }

      statsTimeline.to(
        count,
        {
          val: acceleration,
          duration: 1,
          ease: 'power2.inOut',
          onUpdate: function () {
            const element = document.querySelector(
              '.circle .number2'
            ) as HTMLElement
            if (element) {
              element.innerText = count.val.toFixed(1)
            }
          },
        },
        0
      )
    }

    function updateCarousel(models: any[]) {
      if (!splide) return

      // 停止之前的輪播動畫
      const prevCarouselTimeline = animationTimelines.get('carousel')
      if (prevCarouselTimeline) {
        prevCarouselTimeline.kill()
      }

      const carouselTimeline = gsap.timeline()
      animationTimelines.set('carousel', carouselTimeline)

      const carList = document.getElementById('car-list')
      if (!carList) return

      carouselTimeline
        .to('.taycan-slider', {
          opacity: 0.3,
          duration: 0.3,
          onComplete: () => {
            safeExecute(() => {
              // 清空現有內容
              carList.innerHTML = ''

              // 添加新的幻燈片
              const fragment = document.createDocumentFragment()
              models.forEach((model) => {
                const slide = document.createElement('div')
                slide.className = 'splide__slide'
                slide.innerHTML = `
                <div class="content-wrapper">
                  <h3 class="car-name">${model.name}</h3>
                  <div class="additional-content">
                    <p class="price">${model.price}</p>
                    <button class="view-more" data-car="${model.name}">See more</button>
                  </div>
                  <div class="car-image-carousel">
                    <img src="${model.image}" alt="${model.name}" loading="lazy" />
                  </div>
                </div>
              `
                fragment.appendChild(slide)
              })
              carList.appendChild(fragment)

              // 重新初始化 Splide
              splide.refresh()
              bindViewMoreButtons()
            }, 'Update carousel content failed')
          },
        })
        .to('.taycan-slider', {
          opacity: 1,
          duration: 0.3,
        })
    }

    // 綁定查看更多按鈕事件
    function bindViewMoreButtons() {
      safeExecute(() => {
        document.querySelectorAll('.view-more').forEach((button) => {
          button.addEventListener('click', function () {
            const carName = this.getAttribute('data-car')
            const modal = document.getElementById('carConfigModal')
            if (modal) {
              modal.style.display = 'block'
              document.body.style.overflow = 'hidden'
              window.dispatchEvent(
                new CustomEvent('openCarConfig', {
                  detail: {carName: carName},
                })
              )
            }
          })
        })
      }, 'Bind view more buttons failed')
    }

    // 添加事件監聽器
    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault()
        const model = btn.getAttribute('data-model')
        if (model) {
          debouncedSwitchModel(model)
        }
      })
    })

    // 初始化指示器位置
    updateIndicator(currentModel)
  }

  // 優化 Splide 輪播功能
  function initCarousel() {
    return safeExecute(() => {
      splide = new Splide('.splide', {
        type: 'loop',
        perPage: 4,
        focus: 'center',
        gap: '1rem',
        pagination: false,
        arrows: true,
        speed: 800,
        rewind: false,
        autoWidth: false,
        clones: 4,
        preloadPages: 2,
        visible: 'true',
        cloneStatus: true,
        waitForTransition: true,
        resetProgress: false,
        updateOnMove: true,
        lazyLoad: 'nearby',
        padding: {left: '10%', right: '10%'},
        breakpoints: {
          1024: {
            perPage: 3,
            focus: 'center',
            padding: {left: '15%', right: '15%'},
            gap: '0.8rem',
          },
          992: {
            perPage: 2,
            padding: {left: '5%', right: '5%'},
            gap: '0.5rem',
          },
          768: {
            perPage: 1.5,
            focus: 'center',
            padding: {left: '5%', right: '5%'},
            gap: '0.5rem',
          },
          480: {
            perPage: 1,
            focus: 'center',
            padding: {left: '10%', right: '10%'},
            gap: '0.3rem',
          },
        },
      })

      splide.mount()

      // 事件監聽器
      splide.on('mounted', function () {
        setTimeout(() => {
          splide.refresh()
          setupArrowStyles()
        }, 100)
      })

      splide.on(
        'moved',
        debounce(() => {
          // 預載入鄰近圖片
          preloadNearbyImages()
        }, 200)
      )

      bindViewMoreButtons()
      return splide
    }, 'Initialize carousel failed')
  }

  // 設置箭頭樣式
  function setupArrowStyles() {
    safeExecute(() => {
      const nextArrow = document.querySelector(
        '.splide__arrow--next'
      ) as HTMLElement
      const prevArrow = document.querySelector(
        '.splide__arrow--prev'
      ) as HTMLElement
      const arrows = document.querySelectorAll('.splide__arrow')

      if (nextArrow) nextArrow.style.right = '-2.5em'
      if (prevArrow) prevArrow.style.left = '-4em'

      arrows.forEach((arrow) => {
        const svg = arrow.querySelector('svg') as SVGElement
        if (svg) {
          svg.style.fill = '#fff'
          svg.style.transition = 'fill 0.3s ease'

          arrow.addEventListener('mouseenter', () => {
            svg.style.fill = '#000'
          })

          arrow.addEventListener('mouseleave', () => {
            svg.style.fill = '#fff'
          })
        }
      })

      // 響應式箭頭位置調整
      const adjustArrows = debounce(() => {
        if (window.innerWidth <= 768) {
          if (nextArrow) nextArrow.style.right = '-1em'
          if (prevArrow) prevArrow.style.left = '-2em'
        } else {
          if (nextArrow) nextArrow.style.right = '-2.5em'
          if (prevArrow) prevArrow.style.left = '-4em'
        }
      }, 100)

      adjustArrows()
      window.addEventListener('resize', adjustArrows)
    }, 'Setup arrow styles failed')
  }

  // 預載入鄰近圖片
  function preloadNearbyImages() {
    if (!splide) return

    safeExecute(() => {
      const activeIndex = splide.index
      const slides = document.querySelectorAll('.splide__slide')
      const imagesToPreload = []

      // 預載入前後各2張圖片
      for (let i = -2; i <= 2; i++) {
        const targetIndex = (activeIndex + i + slides.length) % slides.length
        const slide = slides[targetIndex]
        const img = slide?.querySelector('img')
        if (img && img.src) {
          imagesToPreload.push(img.src)
        }
      }

      if (imagesToPreload.length > 0) {
        preloadImages(imagesToPreload)
      }
    }, 'Preload nearby images failed')
  }

  // 綁定查看更多按鈕事件
  function bindViewMoreButtons() {
    safeExecute(() => {
      // 移除舊的事件監聽器
      document.querySelectorAll('.view-more').forEach((button) => {
        const newButton = button.cloneNode(true)
        button.parentNode?.replaceChild(newButton, button)
      })

      // 添加新的事件監聽器
      document.querySelectorAll('.view-more').forEach((button) => {
        button.addEventListener('click', function (e) {
          e.preventDefault()
          const carName = this.getAttribute('data-car')
          const modal = document.getElementById('carConfigModal')
          if (modal) {
            modal.style.display = 'block'
            document.body.style.overflow = 'hidden'
            window.dispatchEvent(
              new CustomEvent('openCarConfig', {
                detail: {carName: carName},
              })
            )
          }
        })
      })
    }, 'Bind view more buttons failed')
  }

  // 優化初始化動畫函數
  async function initializeAnimations() {
    if (isInitialized) return

    try {
      // 預載入所有圖片
      const allImages = []
      Object.values(carData).forEach((car) => {
        allImages.push(car.image)
        car.models.forEach((model) => allImages.push(model.image))
      })

      // 並行載入關鍵圖片和預載入其他圖片
      await Promise.allSettled([
        checkImageLoaded('.car-image'),
        checkImageLoaded('.platform-image'),
        preloadImages(allImages.slice(0, 10)), // 預載入前10張圖片
      ])

      console.log('Critical images loaded, initializing components...')

      // 初始化組件
      initModelSwitch()
      const carouselResult = initCarousel()

      if (!carouselResult) {
        throw new Error('Carousel initialization failed')
      }

      // 設置初始動畫狀態
      setupInitialAnimationStates()

      // 創建滾動觸發器
      createScrollTrigger()

      isInitialized = true
      console.log('Animation initialization completed')
    } catch (error) {
      console.error('Animation initialization failed:', error)
      // 降級處理：即使失敗也要初始化基本功能
      safeExecute(() => {
        initModelSwitch()
        initCarousel()
      }, 'Fallback initialization failed')
    }
  }

  // 設置初始動畫狀態
  function setupInitialAnimationStates() {
    safeExecute(() => {
      // 根據螢幕尺寸設置不同的初始狀態
      const isMobile = window.innerWidth <= 768
      const isTablet = window.innerWidth <= 1024

      gsap.set('.title', {opacity: 0, y: -50})
      gsap.set('.model-switch', {opacity: 0, y: -50})
      gsap.set('.car-image', {y: -500, opacity: 0.5, scale: 0})

      // 針對不同螢幕尺寸調整platform-image位置
      gsap.set('.platform-image', {
        y: isMobile ? '80vh' : isTablet ? '90vh' : '100vh',
        opacity: 0,
      })

      gsap.set(['.circle-left', '.circle-right'], {
        opacity: 0,
        scale: 0,
        xPercent: 0,
        yPercent: 100,
        x: 0,
        y: 0,
      })

      // 針對不同螢幕尺寸調整carousel-container位置
      gsap.set('.carousel-container', {
        y: isMobile ? '60vh' : isTablet ? '80vh' : '100vh',
        opacity: 0,
      })
    }, 'Setup initial animation states failed')
  }

  // 創建滾動觸發器
  function createScrollTrigger() {
    safeExecute(() => {
      // 清理之前的 ScrollTrigger
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill())

      // 根據螢幕尺寸調整ScrollTrigger參數
      const isMobile = window.innerWidth <= 768
      const isTablet = window.innerWidth <= 1024

      const scrollEnd = isMobile ? '+=200%' : isTablet ? '+=250%' : '+=300%'

      ScrollTrigger.create({
        trigger: '.animation-section',
        pin: true,
        start: 'top top',
        end: scrollEnd,
        onRefresh: () => {
          console.log('ScrollTrigger refreshed')
        },
      })

      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: '.animation-section',
          start: 'top top',
          end: scrollEnd,
          scrub: 1,
          onComplete: () => {
            console.log('Animation timeline completed')
          },
        },
      })

      // 根據螢幕尺寸調整動畫參數
      const carImageScale = isTablet ? 1.1 : 1.2
      const platformImageY = isMobile ? '10vh' : isTablet ? '15vh' : '0'
      const carouselBottom = isMobile ? '-2%' : isTablet ? '-3%' : '-4.2071%'

      // 動畫序列
      timeline
        .to('.car-image', {y: 0, opacity: 1, scale: 1, duration: 1})
        .to(
          ['.platform-image', '.carousel-container'],
          {
            y: platformImageY,
            opacity: 1,
            duration: 1.5,
            ease: 'power2.out',
          },
          '-=0.5'
        )
        .to('.car-image', {scale: carImageScale, duration: 1})
        .to(['.circle-left', '.circle-right'], {
          opacity: isTablet ? 0 : 1, // 在平板和手機上隱藏圓形
          scale: isTablet ? 0 : 1,
          duration: 1,
          ease: 'power1.out',
          onComplete: () => {
            if (!isTablet) {
              animateNumbers()
            }
          },
        })

      // 只在桌面版本執行圓形移動動畫
      if (!isTablet) {
        timeline
          .to(
            '.circle-left',
            {
              opacity: 1,
              scale: 1,
              duration: 1,
              motionPath: {
                path: '#leftPath',
                align: '#leftPath',
                autoRotate: false,
                alignOrigin: [0.5, 0.5],
              },
              ease: 'power1.inOut',
            },
            '-=0.5'
          )
          .to(
            '.circle-right',
            {
              opacity: 1,
              scale: 1,
              duration: 1,
              motionPath: {
                path: '#rightPath',
                align: '#rightPath',
                autoRotate: false,
                alignOrigin: [0.5, 0.5],
              },
              ease: 'power1.inOut',
            },
            '<'
          )
      }

      timeline
        .to('.title', {opacity: 1, y: 0, duration: 0.5, ease: 'power1.out'})
        .to(
          '.model-switch',
          {opacity: 1, y: 0, duration: 0.5, ease: 'power1.out'},
          '<'
        )
        .to(
          '.carousel-container',
          {
            bottom: carouselBottom,
            opacity: 1,
            transform: 'translateY(0)',
            duration: 1,
            ease: 'power2.out',
          },
          '-=0.5'
        )

      animationTimelines.set('main', timeline)
    }, 'Create scroll trigger failed')
  }

  // 動畫數字計數
  function animateNumbers() {
    safeExecute(() => {
      const numberTimeline = gsap.timeline()

      numberTimeline.to('.circle .number1', {
        duration: 2,
        innerHTML: leftTarget,
        snap: {innerHTML: 1},
        ease: 'power1.inOut',
      })

      let count = {val: 0}
      numberTimeline.to(
        count,
        {
          val: rightTarget,
          duration: 2,
          ease: 'power1.inOut',
          onUpdate: function () {
            const element = document.querySelector(
              '.circle .number2'
            ) as HTMLElement
            if (element) {
              element.innerText = count.val.toFixed(1)
            }
          },
        },
        0
      )

      animationTimelines.set('numbers', numberTimeline)
    }, 'Animate numbers failed')
  }

  // 清理函數
  function cleanup() {
    // 清理所有動畫時間線
    animationTimelines.forEach((timeline) => {
      if (timeline && timeline.kill) {
        timeline.kill()
      }
    })
    animationTimelines.clear()

    // 清理 ScrollTrigger
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill())

    // 清理 Splide
    if (splide) {
      splide.destroy()
      splide = null
    }

    isInitialized = false
  }

  // 頁面可見性變化處理
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      // 頁面隱藏時暫停動畫
      animationTimelines.forEach((timeline) => {
        if (timeline && timeline.pause) {
          timeline.pause()
        }
      })
    } else {
      // 頁面顯示時恢復動畫
      animationTimelines.forEach((timeline) => {
        if (timeline && timeline.resume) {
          timeline.resume()
        }
      })
    }
  })

  // 頁面卸載時清理
  window.addEventListener('beforeunload', cleanup)

  // 初始化動畫
  initializeAnimations()

  // 響應式處理
  const handleResize = debounce(() => {
    if (isInitialized) {
      cleanup()
      setTimeout(() => {
        initializeAnimations()
      }, 100)
    }
  }, 500)

  window.addEventListener('resize', handleResize)
</script>

