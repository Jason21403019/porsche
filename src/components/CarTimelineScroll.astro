  }

  .taycan-slider
    .splide__slide:not(.is-active):not(.is-prev):not(.is-next)
    .additional-content {
    opacity: 0.5 !important;
  }

  .taycan-slider
    .splide__slide:not(.is-active):not(.is-prev):not(.is-next)
    .car-image-carousel {
    width: 70% !important;
  }

  @media (max-width: 768px) {
    .taycan-slider
      .splide__slide:not(.is-active):not(.is-prev):not(.is-next)
      .car-image-carousel {
