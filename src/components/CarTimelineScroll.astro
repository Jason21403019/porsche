---
interface Props {
  sections: Array<{
    id: string
    years?: string[]
    activeYear?: string
    title: string | string[]
    description: string[]
    imageSrc: string
    gradient?: {
      from: string
      to: string
    }
  }>
}

const { sections } = Astro.props

// 車款數據
const carData = {
  Taycan: {
    image: '/img/redcar.png',
    stats: { maxSpeed: 250, acceleration: 3.3 },
    models: [
      {
        name: 'Taycan',
        price: 'NTD 4,320,000',
        image: '/img/Taycan/taycan/01-02-Photoroom.png',
      },
      {
        name: 'Taycan 4',
        price: 'NTD 4,600,000',
        image: '/img/Taycan/taycan4/Taycan 4-1.png',
      },
      { name: 'Taycan 4s', price: 'NTD 5,320,000', image: '/img/taycan4s.png' },
      {
        name: 'Taycan GTS',
        price: 'NTD 6,580,000',
        image: '/img/taycan-gts.png',
      },
      {
        name: 'Taycan Turbo',
        price: 'NTD 7,680,000',
        image: '/img/taycan-turbo.png',
      },
      {
        name: 'Taycan Turbo S',
        price: 'NTD 9,250,000',
        image: '/img/Taycan-Turbo-S.png',
      },
      {
        name: 'Taycan Turbo GT',
        price: 'NTD 10,480,000',
        image: '/img/taycan-turbo-gt.png',
      },
      {
        name: 'Taycan Turbo GT with Wp',
        price: 'NTD 10,480,000',
        image: '/img/Taycan-Turbo-GT-with-Weissach-Package.png',
      },
    ],
  },
  Macan: {
    image: '/img/Macan/macan/1-02.png',
    stats: { maxSpeed: 220, acceleration: 4.1 },
    models: [
      {
        name: 'Macan',
        price: 'NTD 3,200,000',
        image: '/img/Macan/macan/1-02.png',
      },
      {
        name: 'Macan 4',
        price: 'NTD 3,500,000',
        image: '/img/Macan/Macan 4 Electric/Macan 4 Electric.png',
      },
      {
        name: 'Macan S',
        price: 'NTD 4,100,000',
        image: '/img/Macan/macan s/01-02-Photoroom.png',
      },
      {
        name: 'Macan GTS',
        price: 'NTD 4,800,000',
        image: '/img/Macan/macan gts/01-02.png',
      },
      {
        name: 'Macan Turbo',
        price: 'NTD 5,500,000',
        image: '/img/Macan-Turbo-Electric.png',
      },
    ],
  },
}

const cars = [
  {
    model: 'Taycan',
    image: carData.Taycan.image,
    stats: carData.Taycan.stats,
    models: carData.Taycan.models,
  },
  {
    model: 'Macan',
    image: carData.Macan.image,
    stats: carData.Macan.stats,
    models: carData.Macan.models,
  },
]

let currentModel = 'Taycan'
const currentCar = cars.find((car) => car.model === currentModel) || cars[0]

const introSection = {
  title: 'Green',
  title1: 'Energy',
  title2: 'Track',
  description: 'the future is limitless',
  image: '/img/historybg.jpg',
}
---

<!-- 車款選擇區域 -->
<div class="car-timeline-wrapper">
  <div class="wrapper">
    <section class="section animation-section">
      <div class="content-container">
        <div
          class="car-select"
          style={`background-color: ${currentCar.model === 'Taycan' ? '#313131' : '#8C8C8C'}`}>
          <!-- ModelSwitch 組件內容 -->
          <div class="model-switch">
            <div class="indicator"></div>
            <button
              class={`switch-btn ${currentCar.model === 'Taycan' ? 'active' : ''}`}
              data-model="Taycan">
              Taycan
            </button>
            <button
              class={`switch-btn ${currentCar.model === 'Macan' ? 'active' : ''}`}
              data-model="Macan">
              Macan
            </button>
          </div>

          <h1 class="title" id="model-selection">Model Selection</h1>
          <img
            src={cars[0].image}
            alt="Car"
            class="car-image"
            id="main-car-image"
          />
        </div>

        <img src="/img/graycan.png" alt="Platform" class="platform-image" />

        <!-- 車輛數據圓圈 -->
        <div class="circle circle-left">
          <div class="border_line"></div>
          <span class="number1">000</span>
          <span class="unit">km/h</span>
          <span class="speed">Extreme speed</span>
        </div>
        <div class="circle circle-right">
          <div class="border_line"></div>
          <span class="number2">0</span>
          <span class="unit2">s</span>
          <span class="speed2">0-100 km/h</span>
        </div>

        <!-- 車款輪播 -->
        <div class="carousel-container">
          <div class="taycan-slider" id="car-slider">
            <div class="splide">
              <div class="splide__track">
                <div class="splide__list" id="car-list">
                  {
                    cars[0].models.map((model) => (
                      <div class="splide__slide">
                        <div class="content-wrapper">
                          <h3 class="car-name">{model.name}</h3>
                          <div class="additional-content">
                            <p class="price">{model.price}</p>
                            <button class="view-more" data-car={model.name}>
                              See more
                            </button>
                          </div>
                          <div class="car-image-carousel">
                            <img src={model.image} alt={model.name} />
                          </div>
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <svg
          style="visibility: hidden; position: absolute; width: 0; height: 0;">
          <path id="leftPath" d="M 0,0 C -100,-100 -100,-50 -550,-100"></path>
          <path id="rightPath" d="M 0,0 C 100,-100 100,-50 550,-200"></path>
        </svg>
      </div>
    </section>
  </div>

  <!-- 時間軸橫向滾動區域 -->
  <div class="horizontal-scroll-wrapper">
    <div class="horizontal-scroll-container">
      <div class="horizontal-scroll-sections">
        <!-- 介紹頁面 -->
        <div class="section section--intro">
          <div class="intro__image">
            <img src={introSection.image} alt="Intro" />
          </div>
          <div class="intro__content">
            <h1 data-aos="fade-up" data-aos-duration="500" data-aos-delay="500">
              {introSection.title}
            </h1>
            <h1 data-aos="fade-up" data-aos-duration="500" data-aos-delay="550">
              {introSection.title1}
            </h1>
            <h1 data-aos="fade-up" data-aos-duration="500" data-aos-delay="600">
              {introSection.title2}
            </h1>
            <p data-aos="fade-up" data-aos-duration="500" data-aos-delay="650">
              {introSection.description}
            </p>
          </div>
        </div>

        <!-- 年份內容頁面 -->
        {
          sections.map((section) => (
            <div
              id={section.id}
              class="section section--content"
              data-year={
                section.activeYear || (section.years && section.years[0])
              }
              style={
                section.gradient
                  ? `background: linear-gradient(to right, ${section.gradient.from}, ${section.gradient.to})`
                  : ''
              }>
              <div class="year__column">
                <div class="year__container">
                  {section.years &&
                    section.years.map((year) => (
                      <div
                        class={`year__display ${
                          year === section.activeYear
                            ? 'year__display--active'
                            : ''
                        }`}>
                        {year}
                      </div>
                    ))}
                </div>
              </div>
              <div class="content__column">
                <div class="title-container">
                  {Array.isArray(section.title) ? (
                    section.title.map((title) => <h2>{title}</h2>)
                  ) : (
                    <h2>{section.title}</h2>
                  )}
                </div>
                <div class="description-container">
                  {section.description.map((desc) => (
                    <p set:html={desc} />
                  ))}
                </div>
                <div class="content__image">
                  <img
                    src={section.imageSrc}
                    alt={
                      Array.isArray(section.title)
                        ? section.title.join(' ')
                        : section.title
                    }
                  />
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  /* 防止整個頁面出現水平滾動條 */
  .car-timeline-wrapper {
    position: relative;
    width: 100%;
    overflow-x: hidden;
  }

  .wrapper {
    height: auto;
    width: 100%;
    overflow-x: hidden;
  }

  .section {
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;

    &.animation-section {
      background-color: #282828;
      overflow: hidden;
    }
  }

  .content-container {
    max-width: 1200px;
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    .title {
      font-size: 44px;
      color: white;
      position: absolute;
      top: 56px;
      left: 68px;
      opacity: 0; /* 初始隱藏 */
    }
  }

  .car-select {
    transition: background-color 0.3s ease;
  }

  .car-image {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 50%;
    height: auto;
    opacity: 0;
    z-index: 2;

    @media screen and (max-width: 1024px) {
      top: 35%;
      max-width: 55%;
    }

    @media screen and (max-width: 768px) {
      top: 40%;
      max-width: 65%;
    }
  }

  .platform-image {
    position: absolute;
    top: 65%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 50%;
    height: auto;
    opacity: 0;

    @media screen and (max-width: 1024px) {
      top: 60%;
      max-width: 60%;
    }

    @media screen and (max-width: 768px) {
      top: 55%;
      max-width: 70%;
    }
  }

  .circle {
    position: absolute;
    width: 164px;
    height: 164px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0);
    top: 20%;
    left: 50%;
    z-index: -1;
    border-radius: 50%;
    background: linear-gradient(to left, #ffffff 0%, #ffce60 100%);
    &-left,
    &-right {
      transform: translate(0%, 0%) scale(0);
    }
    .border_line {
      width: 98%;
      height: 98%;
      border-radius: 50%;
      position: absolute;
      background-color: #212121;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .number1,
    .number2 {
      color: white;
      font-size: 24px;
      font-weight: bold;
      position: absolute;
      z-index: 1;
    }

    .number1 {
      font-size: 50px;
      color: red;
      left: 24px;
      font-weight: 300;
      top: 40px;
    }
    .number2 {
      font-size: 50px;
      top: 47px;
      font-weight: 300;
      left: 38px;
      color: red;
    }
    .unit {
      color: red;
      font-size: 16px;
      font-weight: 300;
      z-index: 10;
      top: 67px;
      right: 20px;
      position: absolute;
    }
    .unit2 {
      color: red;
      font-size: 26px;
      font-weight: 300;
      z-index: 10;
      top: 66px;
      right: 42px;
      position: absolute;
    }
    .speed {
      color: #fff;
      font-size: 18px;
      font-weight: 100;
      z-index: 10;
      top: 102px;
      right: 20px;
      position: absolute;
    }
    .speed2 {
      color: #fff;
      font-size: 18px;
      font-weight: 100;
      z-index: 10;
      top: 108px;
      right: 37px;
      position: absolute;
    }
  }

  /* ModelSwitch 樣式 */
  .model-switch {
    position: absolute;
    top: 15%;
    right: 50%;
    z-index: 10;
    display: flex;
    transform: translate(50%, 0);
    background-color: #b0b0b0;
    border-radius: 44px;
    width: 300px;
    padding: 4px;
  }

  .switch-btn {
    font-size: 24px;
    padding: 12px 24px;
    border-radius: 44px;
    color: white;
    border: none;
    background-color: transparent;
    cursor: pointer;
    position: relative;
    z-index: 2;
    flex: 1;
    transition:
      color 0.3s ease,
      font-weight 0.3s ease;

    &.active {
      color: #212121;
      font-weight: 600;
    }
  }

  .indicator {
    position: absolute;
    top: 0px;
    left: 0px;
    width: calc(50%);
    height: calc(100%);
    background: linear-gradient(to right, #ffffff 0%, #ffce60 100%);
    border-radius: 44px;
    transition: transform 0.3s cubic-bezier(0.58, -0.56, 0.38, 1.53);
    z-index: 1;
  }

  /* Carouselcar 樣式 */
  .taycan-slider {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    left: 0%;
    right: 0%;
    padding: 60px 0;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('/img/graybg.png');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: -1;
    }

    .splide {
      width: 100%;
      height: auto;
      max-width: 1200px;
      margin: 0 auto;
      border-radius: 15px;
      padding: 20px;

      @media (max-width: 768px) {
        padding: 10px;
        height: 300px;
      }
    }
    :global(.splide__arrow) {
      background: transparent;
      width: 40px;
      height: 40px;
      border: 2px solid white;
      top: 65%;

      svg {
        fill: #fff !important;
      }
    }

    :global(.taycan-slider .splide__arrow svg) {
      fill: #fff !important;
    }

    .splide__list {
      align-items: flex-end;
    }
  }

  // 在 768px 及以下螢幕寬度隱藏圓形元素
  @media screen and (max-width: 1024px) {
    .circle {
      display: none;
    }
  }

  .carousel-container {
    position: absolute;
    bottom: -100%;
    left: 0;
    width: 100%;
    opacity: 0;
    transform: translateY(100px);

    @media screen and (max-width: 1024px) {
      bottom: -80%;
    }

    @media screen and (max-width: 768px) {
      bottom: -60%;
    }
  }
  /* 橫向滾動區域樣式 */
  .horizontal-scroll-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .horizontal-scroll-container {
    height: 100vh;
    width: 100%;
    overflow: hidden;
  }

  .horizontal-scroll-sections {
    display: flex;
    height: 100vh;
    width: calc(100vw * var(--section-count, 5));
    will-change: transform;
  }

  .section {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;

    &--intro {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    &--content {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  .intro {
    &__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      width: 100%;
      height: 100%;
      box-shadow: -220px -30px 120px rgba(21, 21, 21, 1);
      background: linear-gradient(
        to right,
        rgba(21, 21, 21, 1) 50%,
        #a88b49 100%
      );

      h1 {
        color: #fff;
        font-size: 80px;
        padding-left: 20rem;
        margin: 2rem 0;
      }

      p {
        color: #fff;
        font-size: 36px;
        padding-left: 17rem;
      }
    }

    &__image {
      width: 100%;
      height: 100%;
      overflow: hidden;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: -560px;
        display: block;
      }
    }
  }

  .year {
    &__column {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    &__container {
      display: flex;
      flex-direction: column;
      gap: 5.5rem;
    }

    &__display {
      font-size: 2rem;
      font-weight: bold;
      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      opacity: 0.5;

      &--active {
        font-size: 4rem;
        opacity: 1;
        color: #fff;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      }
    }
  }

  .content {
    &__column {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;

      .title-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;

        h2 {
          font-size: 2.5rem;
          color: white;
        }
      }

      .description-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;

        p {
          font-size: 1.2rem;
          line-height: 1.6;
          color: white;
        }
      }
    }

    &__image {
      width: 100%;
      height: 400px;
      overflow: hidden;

      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }
  }

  /* 響應式設計 */
  @media (max-width: 768px) {
    .intro__content h1 {
      font-size: 50px;
      padding-left: 10rem;
    }

    .intro__content p {
      font-size: 24px;
      padding-left: 8rem;
    }
  }
</style>

<style is:global>
  /* 動態生成的 Splide 內容樣式 - 提高優先級 */
  .taycan-slider .splide__slide {
    transition: all 0.5s ease !important;
  }

  .taycan-slider .splide__slide.is-clone {
    opacity: 1 !important;
  }

  .taycan-slider .splide__slide .content-wrapper {
    background: linear-gradient(180deg, #737373 0%, #d9d9d9 100%) !important;
    border-radius: 15px !important;
    padding: 10px !important;
    padding-top: 32px !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1) !important;
    transition: all 0.5s ease !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    height: 230px !important;
    width: 184px !important;
    position: relative !important;
  }

  .taycan-slider .splide__slide .content-wrapper::after {
    content: '' !important;
    position: absolute !important;
    inset: -10px !important;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.5) 0%,
      transparent 0%
    ) !important;
    z-index: -1 !important;
    pointer-events: none !important;
  }

  @media (max-width: 768px) {
    .taycan-slider .splide__slide .content-wrapper {
      width: 150px !important;
      height: 210px !important;
      padding-top: 20px !important;
    }
  }

  @media (max-width: 480px) {
    .taycan-slider .splide__slide .content-wrapper {
      width: 130px !important;
      height: 190px !important;
    }
  }

  .taycan-slider .splide__slide .car-name {
    height: 48px !important;
    font-size: 24px !important;
    margin: 0 0 15px 0 !important;
    text-align: center !important;
    font-weight: 600 !important;
  }

  @media (max-width: 768px) {
    .taycan-slider .splide__slide .car-name {
      font-size: 20px !important;
      height: 40px !important;
      margin: 0 0 10px 0 !important;
    }
  }

  @media (max-width: 480px) {
    .taycan-slider .splide__slide .car-name {
      font-size: 18px !important;
    }
  }

  .taycan-slider .splide__slide .additional-content {
    width: 100% !important;
    opacity: 0 !important;
    max-height: 0 !important;
    transition: all 0.5s ease !important;
    gap: 15px !important;
    display: flex !important;
    flex-direction: column !important;
  }

  .taycan-slider .splide__slide .car-image-carousel {
    margin: 0 auto !important;
    width: 120% !important;
    height: 180px !important;
    border-radius: 12px !important;
    transform: none !important;
    opacity: 1 !important;
    scale: 1 !important;
  }

  @media (max-width: 768px) {
    .taycan-slider .splide__slide .car-image-carousel {
      width: 100% !important;
      height: 140px !important;
    }
  }

  .taycan-slider .splide__slide .car-image-carousel img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    transform: none !important;
    opacity: 1 !important;
    scale: 1 !important;
  }

  @media (max-width: 768px) {
    .taycan-slider .splide__slide .car-image-carousel img {
      object-position: center 70% !important;
    }
  }

  .taycan-slider .splide__slide .price {
    font-size: 18px !important;
    color: #000 !important;
    margin: 0 !important;
    text-align: center !important;
  }

  .taycan-slider .splide__slide .view-more {
    padding: 5px 25px !important;
    background: linear-gradient(#ffce60, #ede1c8, #ffce60) !important;
    color: #000 !important;
    border: 1px solid !important;
    border-image: linear-gradient(to right, #ffffff, #666) !important;
    border-radius: 32px !important;
    cursor: pointer !important;
    font-size: 16px !important;
    align-self: center !important;
    transition: all 0.3s ease !important;
  }

  .taycan-slider .splide__slide .view-more:hover {
    transform: scale(1.05) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2) !important;
  }

  /* Active slide styles - 最高優先級 */
  .taycan-slider .splide__slide.is-active {
    transform: scale(1) !important;
  }

  .taycan-slider .splide__slide.is-active .content-wrapper {
    background: linear-gradient(to bottom, #313131, #ffce60) !important;
    box-shadow: 0 0 15px rgba(255, 206, 96, 0.25) !important;
    height: 200px !important;
    padding-bottom: 25px !important;
  }

  .taycan-slider .splide__slide.is-active .content-wrapper::after {
    background: radial-gradient(
      circle,
      rgba(255, 206, 96, 0.25) 0%,
      transparent 70%
    ) !important;
  }

  @media (max-width: 768px) {
    .taycan-slider .splide__slide.is-active .content-wrapper {
      height: 190px !important;
    }
  }

